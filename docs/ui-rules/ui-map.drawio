        <mxCell id="219" value="Seasonal artifact + unlock config" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="6771" width="220" height="36" as="geometry"/></mxCell>
