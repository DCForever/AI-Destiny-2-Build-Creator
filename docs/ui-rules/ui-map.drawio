  <diagram id="flow-flow-build-create" name="Create a new build (draft → live)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1632" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Create a new build (draft → live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#e2b714;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="3" value="From library, open New build, draft General, then live edit tabs." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="380" y="24" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="4" value="Open Build library
[signed-in]
/build
📷 build-library" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="5" value="DBR-BLD-001 — DBR-BLD-001 A **Build** is both
a **fully equippable loadout** and a **stable
identity** with **variants**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="7" value="DBR-BLD-005 — DBR-BLD-005 Builds are
**private** per user. Shareable read-only
links are planned, not required for the first
equippable composer slice." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="155" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="9" value="BR-BLD-001 — BR-BLD-001 Build contains one
default variant and optional additional
variants." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="221" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="11" value="BR-TAG-006 — BR-TAG-006 Builds use the **same
concept tag vocabulary** as Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="276" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="13" value="BR-TAG-008 — BR-TAG-008 Tag filter is
available in **SetAttachPicker**, **Sets
list**, and **Builds list**; empty state when
no matches." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="320" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="15" value="BR-VAR-004 — BR-VAR-004 Filter builds by
exotic armor, exotic weapon, and concept tags." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="386" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="17" value="DAC-NME-002 — Tag filter without identity
**Given** builds tagged PVE or Dungeon without
matching synergies **When** the user filters
by those tags **Then** matching builds appear
**And** changing tags does not trigger
identity confirm/fork" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="430" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="19" value="001:SC-002 — 001-build-sets-synergies SC-002
Sets or synergies can be located using search
or concept tag filters in under 5 seconds." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="518" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="21" value="New build → draft General
📷 build-create-draft-general" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="601" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="22" value="Locked compose tabs
📷 build-create-draft-locked-tabs" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="671" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="23" value="Live General
[signed-in]
/build
📷 build-edit-general" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="741" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="24" value="DAC-P1-002 — Build identity established
**Given** designated Synergy Types (and
optional exotic armor item / build-shared
exotic weapon / build-pinned Super) **When**
the user saves the Build **Then** those fields
form build identity **And** concept tags may
be set for filtering only without becoming
identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="741" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="23" target="24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="26" value="DAC-VAR-004 — Identity edit confirm/fork
**Given** an existing build with variants
**When** the user changes designated
synergies, set exotic armor item, build-shared
exotic weapon, or build-pinned Super **Then**
the system warns and offers confirm in-place
or fork" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="851" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="23" target="26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="28" value="DBR-ID-008 — DBR-ID-008 Changing identity
fields requires **confirm in-place** (affects
all variants) or **fork** to a new Build." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="950" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="23" target="28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="30" value="DBR-ID-009 — DBR-ID-009 Identity fields
include: designated synergies; exotic armor
item when set; build-shared exotic weapon when
set; build-pinned Super when set." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1005" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="23" target="30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="32" value="DBR-NAME-004 — DBR-NAME-004 User may rename.
Renamed names must be **unique per class** for
that user." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1071" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="23" target="32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="34" value="Subclass kit
[signed-in]
/build
📷 build-edit-subclass" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1154" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="35" value="DBR-SUB-001 — DBR-SUB-001 **Subclass
element/tree** is shared across all variants
(Solar, Arc, Void, Stasis, Strand, Prismatic)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1154" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="37" value="DBR-SUB-003 — DBR-SUB-003 **Aspects,
fragments, and ability choices** may differ
per variant, except build-pinned Super /
exotic-required pinned abilities." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1209" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="39" value="DBR-SUB-004 — DBR-SUB-004 Illegal subclass
kits (invalid combinations or over
aspect/fragment slot limits) **cannot be
saved**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1275" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="41" value="DBR-SUB-005 — DBR-SUB-005 When an exotic
requires a specific Super / melee / grenade /
class ability, the system **auto-proposes
build-pinned abilities**; user confirms;
**mismatch blocks save**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1341" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="41"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="43" value="DAC-DST-003 — Subclass slot limits **Given** a
subclass kit over aspect/fragment limits or
otherwise illegal **When** the user saves
**Then** save is rejected **And** the
Aspects/Fragments UI caps picks (max 2
aspects; fragments ≤ aspect capacity) when
capacity is known" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1418" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="43"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="45" value="DAC-DST-004 — Exotic ability requirements
**Given** an exotic that requires a specific
ability (curated `exoticAbilityRequirements`)
**When** it is set on the build **Then** the
system proposes pinning that ability at build
level **And** after confirm, mismatched kits
cannot save" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1517" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="45"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="47" value="BR-UI-001 — BR-UI-001 **UI prevents Destiny
hard constraints** for Sets and Builds:
illegal set slot items are not completable via
normal fill; **set-wide exotic exclusivity**
(≤1 exotic weapon per weapon set, ≤1 exotic
armor per armor set); dual exotic on builds;
occupied set slots require replace confirm;
**aspect/fragment capacity**, **armor mod
energy**, and **exotic ability requirements**
when known. Soft guidance remains
non-blocking. **API remains authoritative**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1616" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="47"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="49" value="Finish readiness
📷 build-edit-finish" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1462" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="50" value="DAC (acceptance)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="1552" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="51" value="DBR (domain BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="190" y="1552" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="52" value="BR (feature BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="340" y="1552" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="53" value="Slice AC/SC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="490" y="1552" width="140" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
