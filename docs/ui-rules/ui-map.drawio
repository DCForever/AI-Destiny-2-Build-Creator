  <diagram id="sets" name="Sets">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="6074" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Sets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#e2b714;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="3" value="Structure SSoT for surfaces, flows, and rule attachments across platforms. Rule
wording lives in specs/domain-*.md and business-rules.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="380" y="24" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="4" value="Create set
[signed-in]
/sets
📷 sets-create" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="5" value="BR-SET-001 — BR-SET-001 Users can create,
name, tag, edit, view, and delete Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="7" value="BR-SET-002 — BR-SET-002 Set types are
distinct: **Weapon**, **Armor**, **Mod**,
**Pair**, **Fashion**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="144" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="9" value="BR-SET-004 — BR-SET-004 Sets store **manifest
item references**, not full copies." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="199" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="11" value="BR-TAG-002 — BR-TAG-002 Set **name** is
user-defined and independent of tags (e.g.
name `Ferropotent`, tags `[Melee, PVE,
Solar]`)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="243" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="13" value="BR-TAG-004 — BR-TAG-004 Set names are **unique
per user per set type** (not scoped by tags)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="309" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="15" value="BR-TAG-005 — BR-TAG-005 Tag assignment is
**multi-select** on create/edit via
`ConceptTagPicker`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="353" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="17" value="001:SC-001 — 001-build-sets-synergies SC-001 A
user can create a new categorized set
containing at least 3 items in under 60
seconds." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="408" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="19" value="Set name (unique per type)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="502" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="20" value="BR-TAG-002 — BR-TAG-002 Set **name** is
user-defined and independent of tags (e.g.
name `Ferropotent`, tags `[Melee, PVE,
Solar]`)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="502" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="19" target="20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="22" value="BR-TAG-004 — BR-TAG-004 Set names are **unique
per user per set type** (not scoped by tags)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="568" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="19" target="22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="24" value="Concept tags multi-select" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="640" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="25" value="BR-TAG-001 — BR-TAG-001 Sets and Builds carry
**zero or more concept tags** from a
system-defined vocabulary — not user-typed
strings." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="640" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="24" target="25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="27" value="BR-TAG-005 — BR-TAG-005 Tag assignment is
**multi-select** on create/edit via
`ConceptTagPicker`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="706" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="24" target="27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="29" value="Type (Weapon / Armor / Mod / Pair / Fashion)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="789" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="30" value="BR-SET-002 — BR-SET-002 Set types are
distinct: **Weapon**, **Armor**, **Mod**,
**Pair**, **Fashion**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="789" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="29" target="30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="32" value="Set detail
[signed-in]
/sets
📷 sets-detail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="872" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="33" value="BR-SET-001 — BR-SET-001 Users can create,
name, tag, edit, view, and delete Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="872" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="32" target="33"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="35" value="BR-SET-010 — BR-SET-010 **Armor** set detail
shows EoF six-stat **totals** and
**per-piece** stats when owned instances are
pinned (wishlist has no rolls). Item rows show
catalog identity (element, type/frame,
**tier**, **origin trait**), **selected trait
perks** (not barrel/magazine/stock),
**available trait names**, and **linked
library synergies**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="916" width="300" height="113" as="geometry"/></mxCell>
        <mxCell id="36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="32" target="35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="37" value="BR-SET-011 — BR-SET-011 **Armor** set
per-piece stats and set totals use the piece’s
**base roll** only: sum of equipped
`armor_stats` plug investments (DIM white
base). Equipped armor mods, masterwork, and
tuning are excluded. Catalog instance cards
and inventory sort continue to use live
ItemStats. Distinct from full-loadout
soft-target coverage
([DBR-STAT-005](./domain-business-rules.md))." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1037" width="300" height="124" as="geometry"/></mxCell>
        <mxCell id="38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="32" target="37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="39" value="DAC-NME-004 — Armor set stats and item detail
**Given** an Armor set with one or more
**pinned inventory instances** **When** the
user opens set detail **Then** they see
per-piece Health, Melee, Grenade, Super,
Class, Weapons (when synced) and set
**totals** for those stats **And** each item
row shows identity meta (element, type/frame,
tier, origin trait), selected trait perks (not
barrel/mag/stock), available trait names, and
linked library synergies when present **And**
wishlist/unpinned pieces show that stats are
unknown --- ## Out of scope (domain) | Item |
AC expectation | |------|----------------| |
Emotes | Not modeled | | Consumables /
temporary buffs | Not modeled | | Continuous
realtime inventory sync | Not required;
sync-on-equip with rate limit | | Hard
rollback on partial equip | Not required;
retry | | Shareable links | Planned later; not
P1 | | Auto LLM on every manife…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1169" width="300" height="220" as="geometry"/></mxCell>
        <mxCell id="40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="32" target="39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="41" value="DBR-STAT-001 — DBR-STAT-001 Soft stat targets
use the EoF six: **Class, Grenade, Melee,
Super, Health, Weapons**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="872" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="32" target="41"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="43" value="DBR-CMP-001 — DBR-CMP-001 **Sets are the
normal composition path** (Weapon, Armor, Mod,
Pair, Fashion)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="927" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="32" target="43"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="45" value="Delete set" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="1140" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="46" value="BR-DEL-001 — BR-DEL-001 Deleting a Set
attached to any Build variant is **blocked**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="1140" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="45" target="46"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="48" value="BR-DEL-002 — BR-DEL-002 Blocked deletion shows
affected builds/variants." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="1184" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="45" target="48"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="50" value="BR-DEL-003 — BR-DEL-003 User must detach Set
from all references before deletion." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="1228" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="45" target="50"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="52" value="BR-DEL-004 — BR-DEL-004 Error code:
`SET_IN_USE` with `{ buildIds, variantIds }`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="1272" width="300" height="36" as="geometry"/></mxCell>
