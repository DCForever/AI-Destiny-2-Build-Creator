  </diagram>
  <diagram id="flow-flow-sets-library-edit" name="Sets library — browse, detail, edit, fill, create">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1657" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Sets library — browse, detail, edit, fill, create" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#e2b714;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="3" value="Flow flow.sets-library-edit" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="380" y="24" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="4" value="Browse
[signed-in]
/sets
📷 sets-library" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="5" value="BR-SET-001 — BR-SET-001 Users can create,
name, tag, edit, view, and delete Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="7" value="BR-SET-002 — BR-SET-002 Set types are
distinct: **Weapon**, **Armor**, **Mod**,
**Pair**, **Fashion**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="144" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="9" value="BR-SET-003 — BR-SET-003 Sets are **private per
user**; no sharing in initial scope." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="199" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="11" value="BR-TAG-008 — BR-TAG-008 Tag filter is
available in **SetAttachPicker**, **Sets
list**, and **Builds list**; empty state when
no matches." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="243" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="13" value="DAC-P1-009 — Library bar for P1 done **Given**
P1 compose+equip works **When** evaluating
domain “done” for the primary journey **Then**
the account also has ≥10 synergies and ≥10
sets spanning weapon/armor/mod (ideally pair
or fashion) --- ## P2 — Library curation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="309" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="15" value="DBR-PUR-005 — DBR-PUR-005 Library readiness
bar for the primary journey: at least **≥10
synergies** and **≥10 sets** spanning
weapon/armor/mod (ideally including pair or
fashion)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="397" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="17" value="001:SC-001 — 001-build-sets-synergies SC-001 A
user can create a new categorized set
containing at least 3 items in under 60
seconds." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="474" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="19" value="001:SC-002 — 001-build-sets-synergies SC-002
Sets or synergies can be located using search
or concept tag filters in under 5 seconds." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="540" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="21" value="Detail
[signed-in]
/sets
📷 sets-detail" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="448" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="22" value="BR-SET-001 — BR-SET-001 Users can create,
name, tag, edit, view, and delete Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="448" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="21" target="22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="24" value="BR-SET-010 — BR-SET-010 **Armor** set detail
shows EoF six-stat **totals** and
**per-piece** stats when owned instances are
pinned (wishlist has no rolls). Item rows show
catalog identity (element, type/frame,
**tier**, **origin trait**), **selected trait
perks** (not barrel/magazine/stock),
**available trait names**, and **linked
library synergies**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="492" width="300" height="113" as="geometry"/></mxCell>
        <mxCell id="25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="21" target="24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="26" value="BR-SET-011 — BR-SET-011 **Armor** set
per-piece stats and set totals use the piece’s
**base roll** only: sum of equipped
`armor_stats` plug investments (DIM white
base). Equipped armor mods, masterwork, and
tuning are excluded. Catalog instance cards
and inventory sort continue to use live
ItemStats. Distinct from full-loadout
soft-target coverage
([DBR-STAT-005](./domain-business-rules.md))." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="613" width="300" height="124" as="geometry"/></mxCell>
        <mxCell id="27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="21" target="26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="28" value="DAC-NME-004 — Armor set stats and item detail
**Given** an Armor set with one or more
**pinned inventory instances** **When** the
user opens set detail **Then** they see
per-piece Health, Melee, Grenade, Super,
Class, Weapons (when synced) and set
**totals** for those stats **And** each item
row shows identity meta (element, type/frame,
tier, origin trait), selected trait perks (not
barrel/mag/stock), available trait names, and
linked library synergies when present **And**
wishlist/unpinned pieces show that stats are
unknown --- ## Out of scope (domain) | Item |
AC expectation | |------|----------------| |
Emotes | Not modeled | | Consumables /
temporary buffs | Not modeled | | Continuous
realtime inventory sync | Not required;
sync-on-equip with rate limit | | Hard
rollback on partial equip | Not required;
retry | | Shareable links | Planned later; not
P1 | | Auto LLM on every manife…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="745" width="300" height="220" as="geometry"/></mxCell>
        <mxCell id="29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="21" target="28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="30" value="DBR-STAT-001 — DBR-STAT-001 Soft stat targets
use the EoF six: **Class, Grenade, Melee,
Super, Health, Weapons**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="448" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="21" target="30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="32" value="DBR-CMP-001 — DBR-CMP-001 **Sets are the
normal composition path** (Weapon, Armor, Mod,
Pair, Fashion)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="503" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="21" target="32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="34" value="Edit form
[signed-in]
/sets
📷 sets-edit" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="716" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="35" value="BR-SET-001 — BR-SET-001 Users can create,
name, tag, edit, view, and delete Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="716" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="37" value="BR-TAG-005 — BR-TAG-005 Tag assignment is
**multi-select** on create/edit via
`ConceptTagPicker`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="760" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="39" value="BR-SLOT-001 — BR-SLOT-001 **Weapon Sets**: at
most 0 or 1 item per primary, special, heavy." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="815" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="41" value="Fill slot → Catalog embed
[signed-in]
/sets
📷 sets-fill-slot" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="887" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="42" value="DAC-NME-003 — Catalog multi-facet browse
**Given** a user browsing weapons or armor in
Catalog (including set-fill constrained pick)
**When** they combine free-text with
multi-value facets (e.g. element, ammo,
archetype) including include and exclude
**Then** results respect OR-within-facet,
AND-across-facets, and exclude-drop semantics
**And** optional group-by dimensions partition
the result list without changing filter
semantics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="887" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="41" target="42"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="44" value="DBR-ROLL-010 — DBR-ROLL-010 Catalog **browse**
for composition supports multi-dimension
filtering (e.g. element, ammo,
archetype/frame, slot, class, exotic
constraint, free-text, optional synergy
membership) with **include OR within a
facet**, **AND across facets**, and
**exclude** drops; optional **group-by** one
or more dimensions for browse. Catalog is a
composition aid, not a separate product job
(see DBR-PUR-002)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1030" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="41" target="44"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="46" value="DAC-DST-009 — UI prevention of hard
composition constraints **Given** a user
composing a Set (slot fill) or Build/variant
(equipment, exotics, kit, mods) **When** an
action would violate a Destiny hard rule
(illegal set slot item, **second exotic in a
weapon/armor set**, dual exotic on a variant,
slot conflict, illegal kit, mod energy, exotic
ability mismatch) **Then** the normal UI
filters or blocks the action with
plain-language reasons **And** the API still
rejects the same invalid payload if submitted
--- ## Naming &amp; browsing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1173" width="300" height="157" as="geometry"/></mxCell>
        <mxCell id="47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="41" target="46"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="48" value="BR-SLOT-008 — BR-SLOT-008 **Weapon Sets**: at
most **one exotic weapon** across all slots
(kit must stay attachable without
dual-exotic). Replacing the slot that holds
the exotic is allowed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1338" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="41" target="48"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="50" value="BR-SLOT-009 — BR-SLOT-009 **Armor Sets**: at
most **one exotic armor** (including exotic
class item) across all slots. Replacing the
exotic piece’s slot is allowed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="887" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="41" target="50"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="52" value="BR-UI-001 — BR-UI-001 **UI prevents Destiny
hard constraints** for Sets and Builds:
illegal set slot items are not completable via
normal fill; **set-wide exotic exclusivity**
(≤1 exotic weapon per weapon set, ≤1 exotic
armor per armor set); dual exotic on builds;
occupied set slots require replace confirm;
**aspect/fragment capacity**, **armor mod
energy**, and **exotic ability requirements**
when known. Soft guidance remains
non-blocking. **API remains authoritative**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="953" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="41" target="52"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="54" value="Create
[signed-in]
/sets
📷 sets-create" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1155" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="55" value="BR-SET-001 — BR-SET-001 Users can create,
name, tag, edit, view, and delete Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1155" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="54" target="55"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="57" value="BR-SET-002 — BR-SET-002 Set types are
distinct: **Weapon**, **Armor**, **Mod**,
**Pair**, **Fashion**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1199" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="54" target="57"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="59" value="BR-SET-004 — BR-SET-004 Sets store **manifest
item references**, not full copies." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1254" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="54" target="59"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="61" value="BR-TAG-002 — BR-TAG-002 Set **name** is
user-defined and independent of tags (e.g.
name `Ferropotent`, tags `[Melee, PVE,
Solar]`)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1298" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="54" target="61"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="63" value="BR-TAG-004 — BR-TAG-004 Set names are **unique
per user per set type** (not scoped by tags)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1364" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="54" target="63"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="65" value="BR-TAG-005 — BR-TAG-005 Tag assignment is
**multi-select** on create/edit via
`ConceptTagPicker`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1408" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="54" target="65"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="67" value="001:SC-001 — 001-build-sets-synergies SC-001 A
user can create a new categorized set
containing at least 3 items in under 60
seconds." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1463" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="54" target="67"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="69" value="DAC (acceptance)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="1577" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="70" value="DBR (domain BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="190" y="1577" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="71" value="BR (feature BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="340" y="1577" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="72" value="Slice AC/SC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="490" y="1577" width="140" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="flow-flow-synergy-library-edit" name="Synergy library — browse, detail, create">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1164" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Synergy library — browse, detail, create" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#e2b714;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="3" value="Flow flow.synergy-library-edit" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="380" y="24" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="4" value="Browse
[signed-in]
/synergy
📷 synergy-library" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="5" value="DAC-P2-001 — Curated synergies with evidence
links **Given** a user curating synergies
**When** they create/edit a synergy with links
to weapons, perks, origin traits, set bonuses,
exotic armor, artifact perks, etc. **Then**
links validate against manifest data **And**
links are evidence by default; any link kind
may be marked required (AND semantics) **And**
exotic weapon trait plugs are valid
`weapon_perk` evidence targets (not only
legendary perk rolls) **And** objects already
linked on this synergy are omitted from that
synergy’s link search results (no duplicate
evidence targets on one row) **And**
weapon-perk search shows whether a hit is an
exotic intrinsic/trait vs a legendary perk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="7" value="DAC-P1-009 — Library bar for P1 done **Given**
P1 compose+equip works **When** evaluating
domain “done” for the primary journey **Then**
the account also has ≥10 synergies and ≥10
sets spanning weapon/armor/mod (ideally pair
or fashion) --- ## P2 — Library curation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="298" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="9" value="DBR-PUR-005 — DBR-PUR-005 Library readiness
bar for the primary journey: at least **≥10
synergies** and **≥10 sets** spanning
weapon/armor/mod (ideally including pair or
fashion)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="386" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="11" value="DBR-SYN-001 — DBR-SYN-001 A Synergy is **Type
linked with an Object**: a curated
play-pattern (`type` + optional `subType`)
with linked gear evidence (Objects: weapon,
perk, origin trait, armor set bonus, exotic
armor, artifact perk, etc.)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="463" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="13" value="BR-SYN-001 — BR-SYN-001 Users create and
manage library Synergies of defined types
(Melee, Verb, Grenade, etc.). **Create** sets
type + optional subtype; **edit** may change
description and links only — **type and
subtype are immutable after create**.
**Superseded in part by**
[DBR-SYN-012](./domain-business-rules.md)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="551" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="15" value="001:SC-002 — 001-build-sets-synergies SC-002
Sets or synergies can be located using search
or concept tag filters in under 5 seconds." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="100" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="17" value="Detail
[signed-in]
/synergy
📷 synergy-detail" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="368" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="18" value="DAC-P2-001 — Curated synergies with evidence
links **Given** a user curating synergies
**When** they create/edit a synergy with links
to weapons, perks, origin traits, set bonuses,
exotic armor, artifact perks, etc. **Then**
links validate against manifest data **And**
links are evidence by default; any link kind
may be marked required (AND semantics) **And**
exotic weapon trait plugs are valid
`weapon_perk` evidence targets (not only
legendary perk rolls) **And** objects already
linked on this synergy are omitted from that
synergy’s link search results (no duplicate
evidence targets on one row) **And**
weapon-perk search shows whether a hit is an
exotic intrinsic/trait vs a legendary perk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="368" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="20" value="DBR-SYN-001 — DBR-SYN-001 A Synergy is **Type
linked with an Object**: a curated
play-pattern (`type` + optional `subType`)
with linked gear evidence (Objects: weapon,
perk, origin trait, armor set bonus, exotic
armor, artifact perk, etc.)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="566" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="22" value="DBR-SYN-007 — DBR-SYN-007 Synergy links are
**evidence by default**. Authors may mark
specific links **required**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="654" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="24" value="DBR-SYN-008 — DBR-SYN-008 Required flag may
apply to **any** link kind (weapon, perk,
origin trait, armor set bonus, etc.)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="709" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="26" value="DBR-SYN-009 — DBR-SYN-009 Multiple required
links on one synergy are **AND** — all must be
satisfied." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="764" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="28" value="DBR-SYN-014 — DBR-SYN-014 **Weapon perk**
evidence includes **exotic weapon trait
plugs** (and other exotic WEAPON PERKS
sockets), not only legendary perk rolls — e.g.
Lodestar **Arc Alignment** is a valid
`weapon_perk` target for a Verb: Jolt library
synergy." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="819" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="30" value="BR-SYN-011 — BR-SYN-011 Within **one** library
synergy, each evidence target appears **at
most once**. Link search/picker results omit
objects already on the draft link list; save
paths dedupe by coverage key. Does not limit
the same target linking to **other** synergies
(BR-SYN-008)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="368" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="32" value="BR-SYN-012 — BR-SYN-012 Weapon-perk link
search labels each hit as **exotic
intrinsic/trait**, **legendary perk**, or
**legendary &amp; exotic** based on host weapon
tier and plug role, so curators can
distinguish exotic evidence from legendary
rolls." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="467" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="34" value="Create
[signed-in]
/synergy
📷 synergy-create" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="716" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="35" value="DAC-P2-001 — Curated synergies with evidence
links **Given** a user curating synergies
**When** they create/edit a synergy with links
to weapons, perks, origin traits, set bonuses,
exotic armor, artifact perks, etc. **Then**
links validate against manifest data **And**
links are evidence by default; any link kind
may be marked required (AND semantics) **And**
exotic weapon trait plugs are valid
`weapon_perk` evidence targets (not only
legendary perk rolls) **And** objects already
linked on this synergy are omitted from that
synergy’s link search results (no duplicate
evidence targets on one row) **And**
weapon-perk search shows whether a hit is an
exotic intrinsic/trait vs a legendary perk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="716" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="37" value="DAC-P2-003 — Personal keywords / custom
synergy types **Given** a keyword/synergy type
missing from global vocabulary **When** the
user creates a personal custom type grounded
in a keyword (e.g. Poison) **Then** it can be
used for intent and synergies **And** it may
later be promoted to global" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="914" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="39" value="DBR-SYN-001 — DBR-SYN-001 A Synergy is **Type
linked with an Object**: a curated
play-pattern (`type` + optional `subType`)
with linked gear evidence (Objects: weapon,
perk, origin trait, armor set bonus, exotic
armor, artifact perk, etc.)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1013" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="41" value="DBR-SYN-005 — DBR-SYN-005 Users may create
**personal custom synergy types** grounded in
keyword/verb-like concepts (e.g. Corruption,
Poison)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1101" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="41"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="43" value="DBR-SYN-006 — DBR-SYN-006 Keywords may come
from the **global vocabulary** or **personal
keywords**, with optional later
promote-to-global." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1167" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="43"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="45" value="DBR-SYN-012 — DBR-SYN-012 A library Synergy’s
**designation** (`type` + `subType`) is
**immutable after create**. Create may set
type/subtype; edit may change description and
linked Objects only. Attempts to change type
or subtype after create are rejected." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="716" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="45"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="47" value="BR-SYN-001 — BR-SYN-001 Users create and
manage library Synergies of defined types
(Melee, Verb, Grenade, etc.). **Create** sets
type + optional subtype; **edit** may change
description and links only — **type and
subtype are immutable after create**.
**Superseded in part by**
[DBR-SYN-012](./domain-business-rules.md)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="804" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="47"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="49" value="BR-SYN-003 — BR-SYN-003 Multiple designated
synergies on a build contribute **equally** to
suggestions. Affirmed by
[DBR-SYN-004](./domain-business-rules.md)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="914" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="49"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="51" value="DAC (acceptance)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="1084" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="52" value="DBR (domain BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="190" y="1084" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="53" value="BR (feature BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="340" y="1084" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="54" value="Slice AC/SC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="490" y="1084" width="140" height="32" as="geometry"/></mxCell>
      </root>
