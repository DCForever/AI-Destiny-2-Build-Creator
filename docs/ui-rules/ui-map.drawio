        <mxCell id="590" value="Edit build (open composer)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="18651" width="220" height="36" as="geometry"/></mxCell>
