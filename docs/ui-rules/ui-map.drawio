  </diagram>
  <diagram id="synergy" name="Synergy">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="4145" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Synergy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#e2b714;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="3" value="Structure SSoT for surfaces, flows, and rule attachments across platforms. Rule
wording lives in specs/domain-*.md and business-rules.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="380" y="24" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="4" value="Create synergy
[signed-in]
/synergy
📷 synergy-create" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="5" value="DAC-P2-001 — Curated synergies with evidence
links **Given** a user curating synergies
**When** they create/edit a synergy with links
to weapons, perks, origin traits, set bonuses,
exotic armor, artifact perks, etc. **Then**
links validate against manifest data **And**
links are evidence by default; any link kind
may be marked required (AND semantics) **And**
exotic weapon trait plugs are valid
`weapon_perk` evidence targets (not only
legendary perk rolls) **And** objects already
linked on this synergy are omitted from that
synergy’s link search results (no duplicate
evidence targets on one row) **And**
weapon-perk search shows whether a hit is an
exotic intrinsic/trait vs a legendary perk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="7" value="DAC-P2-003 — Personal keywords / custom
synergy types **Given** a keyword/synergy type
missing from global vocabulary **When** the
user creates a personal custom type grounded
in a keyword (e.g. Poison) **Then** it can be
used for intent and synergies **And** it may
later be promoted to global" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="298" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="9" value="DBR-SYN-001 — DBR-SYN-001 A Synergy is **Type
linked with an Object**: a curated
play-pattern (`type` + optional `subType`)
with linked gear evidence (Objects: weapon,
perk, origin trait, armor set bonus, exotic
armor, artifact perk, etc.)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="397" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="11" value="DBR-SYN-005 — DBR-SYN-005 Users may create
**personal custom synergy types** grounded in
keyword/verb-like concepts (e.g. Corruption,
Poison)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="485" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="13" value="DBR-SYN-006 — DBR-SYN-006 Keywords may come
from the **global vocabulary** or **personal
keywords**, with optional later
promote-to-global." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="551" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="15" value="DBR-SYN-012 — DBR-SYN-012 A library Synergy’s
**designation** (`type` + `subType`) is
**immutable after create**. Create may set
type/subtype; edit may change description and
linked Objects only. Attempts to change type
or subtype after create are rejected." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="100" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="17" value="BR-SYN-001 — BR-SYN-001 Users create and
manage library Synergies of defined types
(Melee, Verb, Grenade, etc.). **Create** sets
type + optional subtype; **edit** may change
description and links only — **type and
subtype are immutable after create**.
**Superseded in part by**
[DBR-SYN-012](./domain-business-rules.md)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="188" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="19" value="BR-SYN-003 — BR-SYN-003 Multiple designated
synergies on a build contribute **equally** to
suggestions. Affirmed by
[DBR-SYN-004](./domain-business-rules.md)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="298" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="21" value="Personal custom synergy type / keyword" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="448" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="22" value="DAC-P2-003 — Personal keywords / custom
synergy types **Given** a keyword/synergy type
missing from global vocabulary **When** the
user creates a personal custom type grounded
in a keyword (e.g. Poison) **Then** it can be
used for intent and synergies **And** it may
later be promoted to global" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="448" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="21" target="22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="24" value="DBR-SYN-005 — DBR-SYN-005 Users may create
**personal custom synergy types** grounded in
keyword/verb-like concepts (e.g. Corruption,
Poison)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="547" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="21" target="24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="26" value="DBR-SYN-006 — DBR-SYN-006 Keywords may come
from the **global vocabulary** or **personal
keywords**, with optional later
promote-to-global." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="613" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="21" target="26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="28" value="Description" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="707" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="29" value="Type + optional subtype (immutable after create)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="771" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="30" value="DBR-SYN-012 — DBR-SYN-012 A library Synergy’s
**designation** (`type` + `subType`) is
**immutable after create**. Create may set
type/subtype; edit may change description and
linked Objects only. Attempts to change type
or subtype after create are rejected." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="771" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="29" target="30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="32" value="DAC-P2-001a — Library designation immutable
after create **Given** a library synergy
already created with a type and optional
subtype **When** the user edits that synergy
**Then** they may change description and
linked Objects **And** they cannot change type
or subtype (UI read-only; API rejects
designation changes)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="859" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="29" target="32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="34" value="Synergy detail / evidence
[signed-in]
/synergy
📷 synergy-detail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="997" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="35" value="DAC-P2-001 — Curated synergies with evidence
links **Given** a user curating synergies
**When** they create/edit a synergy with links
to weapons, perks, origin traits, set bonuses,
exotic armor, artifact perks, etc. **Then**
links validate against manifest data **And**
links are evidence by default; any link kind
may be marked required (AND semantics) **And**
exotic weapon trait plugs are valid
`weapon_perk` evidence targets (not only
legendary perk rolls) **And** objects already
linked on this synergy are omitted from that
synergy’s link search results (no duplicate
evidence targets on one row) **And**
weapon-perk search shows whether a hit is an
exotic intrinsic/trait vs a legendary perk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="997" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="37" value="DBR-SYN-001 — DBR-SYN-001 A Synergy is **Type
linked with an Object**: a curated
play-pattern (`type` + optional `subType`)
with linked gear evidence (Objects: weapon,
perk, origin trait, armor set bonus, exotic
armor, artifact perk, etc.)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1195" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="39" value="DBR-SYN-007 — DBR-SYN-007 Synergy links are
**evidence by default**. Authors may mark
specific links **required**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1283" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="41" value="DBR-SYN-008 — DBR-SYN-008 Required flag may
apply to **any** link kind (weapon, perk,
origin trait, armor set bonus, etc.)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1338" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="41"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="43" value="DBR-SYN-009 — DBR-SYN-009 Multiple required
links on one synergy are **AND** — all must be
satisfied." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1393" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="43"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="45" value="DBR-SYN-014 — DBR-SYN-014 **Weapon perk**
evidence includes **exotic weapon trait
plugs** (and other exotic WEAPON PERKS
sockets), not only legendary perk rolls — e.g.
Lodestar **Arc Alignment** is a valid
`weapon_perk` target for a Verb: Jolt library
synergy." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1448" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="45"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="47" value="BR-SYN-011 — BR-SYN-011 Within **one** library
synergy, each evidence target appears **at
most once**. Link search/picker results omit
objects already on the draft link list; save
paths dedupe by coverage key. Does not limit
the same target linking to **other** synergies
(BR-SYN-008)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="997" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="47"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="49" value="BR-SYN-012 — BR-SYN-012 Weapon-perk link
search labels each hit as **exotic
intrinsic/trait**, **legendary perk**, or
**legendary &amp; exotic** based on host weapon
tier and plug role, so curators can
distinguish exotic evidence from legendary
rolls." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="1096" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="34" target="49"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="51" value="Designation (read-only after create)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="1345" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="52" value="DAC-P2-001a — Library designation immutable
after create **Given** a library synergy
already created with a type and optional
subtype **When** the user edits that synergy
**Then** they may change description and
linked Objects **And** they cannot change type
or subtype (UI read-only; API rejects
designation changes)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="1345" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="51" target="52"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="54" value="DBR-SYN-012 — DBR-SYN-012 A library Synergy’s
**designation** (`type` + `subType`) is
**immutable after create**. Create may set
type/subtype; edit may change description and
linked Objects only. Attempts to change type
or subtype after create are rejected." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="1455" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="51" target="54"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="56" value="Duplicate synergy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="1571" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="57" value="BR-SYN-004 — BR-SYN-004 **All** linked
synergies surface as tags/notes when viewing a
matching weapon, perk, origin trait, or armor
set bonus in catalog/inventory." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="1571" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="56" target="57"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="59" value="Edit description / objects only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="1665" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="60" value="DAC-P2-001a — Library designation immutable
after create **Given** a library synergy
already created with a type and optional
subtype **When** the user edits that synergy
**Then** they may change description and
linked Objects **And** they cannot change type
or subtype (UI read-only; API rejects
designation changes)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="1665" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="59" target="60"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="62" value="DBR-SYN-012 — DBR-SYN-012 A library Synergy’s
**designation** (`type` + `subType`) is
**immutable after create**. Create may set
type/subtype; edit may change description and
linked Objects only. Attempts to change type
or subtype after create are rejected." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="1775" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="59" target="62"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="64" value="Evidence links list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1891" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="65" value="DAC-P2-001 — Curated synergies with evidence
links **Given** a user curating synergies
**When** they create/edit a synergy with links
to weapons, perks, origin traits, set bonuses,
exotic armor, artifact perks, etc. **Then**
links validate against manifest data **And**
links are evidence by default; any link kind
may be marked required (AND semantics) **And**
exotic weapon trait plugs are valid
`weapon_perk` evidence targets (not only
legendary perk rolls) **And** objects already
linked on this synergy are omitted from that
synergy’s link search results (no duplicate
evidence targets on one row) **And**
weapon-perk search shows whether a hit is an
exotic intrinsic/trait vs a legendary perk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="1891" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="64" target="65"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="67" value="DBR-SYN-007 — DBR-SYN-007 Synergy links are
**evidence by default**. Authors may mark
specific links **required**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="2089" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="64" target="67"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="69" value="DBR-SYN-014 — DBR-SYN-014 **Weapon perk**
evidence includes **exotic weapon trait
plugs** (and other exotic WEAPON PERKS
sockets), not only legendary perk rolls — e.g.
Lodestar **Arc Alignment** is a valid
`weapon_perk` target for a Verb: Jolt library
synergy." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="2144" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="64" target="69"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="71" value="Add link (manifest search)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="2271" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="72" value="BR-SYN-011 — BR-SYN-011 Within **one** library
synergy, each evidence target appears **at
most once**. Link search/picker results omit
objects already on the draft link list; save
paths dedupe by coverage key. Does not limit
the same target linking to **other** synergies
(BR-SYN-008)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2271" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="71" target="72"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="74" value="BR-SYN-012 — BR-SYN-012 Weapon-perk link
search labels each hit as **exotic
intrinsic/trait**, **legendary perk**, or
**legendary &amp; exotic** based on host weapon
tier and plug role, so curators can
distinguish exotic evidence from legendary
rolls." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2370" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="71" target="74"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="76" value="DBR-SYN-014 — DBR-SYN-014 **Weapon perk**
evidence includes **exotic weapon trait
plugs** (and other exotic WEAPON PERKS
sockets), not only legendary perk rolls — e.g.
Lodestar **Arc Alignment** is a valid
`weapon_perk` target for a Verb: Jolt library
synergy." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2469" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="71" target="76"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="78" value="Link kinds (weapon, perk, origin, set bonus, exotic, artifact…)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="2596" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="79" value="DBR-SYN-001 — DBR-SYN-001 A Synergy is **Type
linked with an Object**: a curated
play-pattern (`type` + optional `subType`)
with linked gear evidence (Objects: weapon,
perk, origin trait, armor set bonus, exotic
armor, artifact perk, etc.)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2596" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="78" target="79"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="81" value="DBR-SYN-008 — DBR-SYN-008 Required flag may
apply to **any** link kind (weapon, perk,
