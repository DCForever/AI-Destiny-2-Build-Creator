        <mxCell id="30" value="003:SC-005 — 003-owned-inventory-instances
SC-005 Unauthenticated or never-synced users
receive a clear, actionable response (auth
error or sync prompt) with zero instance data
leaked in 100% of unauthorized or empty-state
test cases." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="1128" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="27" target="30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="32" value="Theme toggle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="1244" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="33" value="DAC (acceptance)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="1328" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="34" value="DBR (domain BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="190" y="1328" width="140" height="32" as="geometry"/></mxCell>
