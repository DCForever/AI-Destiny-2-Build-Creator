        <mxCell id="217" value="DBR-FASH-005 — DBR-FASH-005 Fashion is **not**
identity and does not drive
synergies/suggestions/stats." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="6398" width="300" height="47" as="geometry"/></mxCell>
