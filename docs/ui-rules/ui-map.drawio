        <mxCell id="97" value="Linked library synergies" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="4672" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="98" value="DBR-SYN-001 — DBR-SYN-001 A Synergy is **Type
linked with an Object**: a curated
play-pattern (`type` + optional `subType`)
with linked gear evidence (Objects: weapon,
perk, origin trait, armor set bonus, exotic
armor, artifact perk, etc.)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4672" width="300" height="80" as="geometry"/></mxCell>
