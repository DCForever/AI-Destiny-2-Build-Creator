        <mxCell id="10" value="DAC-P2-005 — In-flow create still works
**Given** a thin library **When** the user
composes a build **Then** they can create
needed synergies/sets during compose without a
hard library gate --- ## Variants &amp; identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="227" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="12" value="BR-BLD-008 — BR-BLD-008 Finish primary path is
**slot-first**: one-tap Create (inherited
name, category type, no tags) or preferred
Capture, then first empty required slot fill
loop. Finish does not require
link/name/type/tag chrome; variant Sets tab
retains advanced create/link." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="304" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="9" target="12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="14" value="DBR-ROLL-010 — DBR-ROLL-010 Catalog **browse**
for composition supports multi-dimension
filtering (e.g. element, ammo,
archetype/frame, slot, class, exotic
constraint, free-text, optional synergy
membership) with **include OR within a
facet**, **AND across facets**, and
**exclude** drops; optional **group-by** one
or more dimensions for browse. Catalog is a
composition aid, not a separate product job
(see DBR-PUR-002)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="403" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="9" target="14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="16" value="DAC (acceptance)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="594" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="17" value="DBR (domain BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="190" y="594" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="18" value="BR (feature BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="340" y="594" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="19" value="Slice AC/SC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="490" y="594" width="140" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="flow-flow-intent-compose-equip" name="P1 spine — Intent → Compose → Equip">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1177" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="P1 spine — Intent → Compose → Equip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#e2b714;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="3" value="Flow flow.intent-compose-equip" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="380" y="24" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="4" value="Intent on General
📷 build-create-draft-general" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="5" value="Subclass
[signed-in]
/build
📷 build-edit-subclass" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="6" value="DBR-SUB-001 — DBR-SUB-001 **Subclass
element/tree** is shared across all variants
(Solar, Arc, Void, Stasis, Strand, Prismatic)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="170" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="8" value="DBR-SUB-003 — DBR-SUB-003 **Aspects,
fragments, and ability choices** may differ
per variant, except build-pinned Super /
exotic-required pinned abilities." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="225" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="5" target="8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="10" value="DBR-SUB-004 — DBR-SUB-004 Illegal subclass
kits (invalid combinations or over
aspect/fragment slot limits) **cannot be
saved**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="291" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="5" target="10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="12" value="DBR-SUB-005 — DBR-SUB-005 When an exotic
requires a specific Super / melee / grenade /
class ability, the system **auto-proposes
build-pinned abilities**; user confirms;
**mismatch blocks save**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="357" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="5" target="12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="14" value="DAC-DST-003 — Subclass slot limits **Given** a
subclass kit over aspect/fragment limits or
otherwise illegal **When** the user saves
**Then** save is rejected **And** the
Aspects/Fragments UI caps picks (max 2
aspects; fragments ≤ aspect capacity) when
capacity is known" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="434" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="5" target="14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="16" value="DAC-DST-004 — Exotic ability requirements
**Given** an exotic that requires a specific
ability (curated `exoticAbilityRequirements`)
**When** it is set on the build **Then** the
system proposes pinning that ability at build
level **And** after confirm, mismatched kits
cannot save" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="533" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="5" target="16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="18" value="BR-UI-001 — BR-UI-001 **UI prevents Destiny
hard constraints** for Sets and Builds:
illegal set slot items are not completable via
normal fill; **set-wide exotic exclusivity**
(≤1 exotic weapon per weapon set, ≤1 exotic
armor per armor set); dual exotic on builds;
occupied set slots require replace confirm;
**aspect/fragment capacity**, **armor mod
energy**, and **exotic ability requirements**
when known. Soft guidance remains
non-blocking. **API remains authoritative**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="632" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="5" target="18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="20" value="Armor
[signed-in]
/build
📷 build-edit-armor-reuse" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="478" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="21" value="BR-ATT-001 — BR-ATT-001 Users attach one or
more Sets to a Build variant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="478" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="20" target="21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="23" value="BR-ATT-002 — BR-ATT-002 Attachment mode:
**live** (default) or **snapshot**, per
variant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="522" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="20" target="23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="25" value="DBR-CMP-003 — DBR-CMP-003 Set attachments
default to **live**; user may snapshot for a
frozen equipable variant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="577" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="20" target="25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="27" value="Weapon
[signed-in]
/build
📷 build-edit-weapon-create" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="28" value="DAC-P2-005 — In-flow create still works
**Given** a thin library **When** the user
composes a build **Then** they can create
needed synergies/sets during compose without a
hard library gate --- ## Variants &amp; identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="660" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="27" target="28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="30" value="BR-BLD-008 — BR-BLD-008 Finish primary path is
**slot-first**: one-tap Create (inherited
name, category type, no tags) or preferred
Capture, then first empty required slot fill
loop. Finish does not require
link/name/type/tag chrome; variant Sets tab
retains advanced create/link." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="737" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="27" target="30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="32" value="DBR-ROLL-010 — DBR-ROLL-010 Catalog **browse**
for composition supports multi-dimension
filtering (e.g. element, ammo,
archetype/frame, slot, class, exotic
constraint, free-text, optional synergy
membership) with **include OR within a
facet**, **AND across facets**, and
**exclude** drops; optional **group-by** one
or more dimensions for browse. Catalog is a
composition aid, not a separate product job
(see DBR-PUR-002)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="836" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="27" target="32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="34" value="Finish
📷 build-edit-finish" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1007" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="35" value="DAC (acceptance)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="1097" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="36" value="DBR (domain BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="190" y="1097" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="37" value="BR (feature BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="340" y="1097" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="38" value="Slice AC/SC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="490" y="1097" width="140" height="32" as="geometry"/></mxCell>
