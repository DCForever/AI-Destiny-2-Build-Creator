        <mxCell id="203" value="DBR-ART-001 — DBR-ART-001 There are **6 fixed
artifacts**, switchable via API; not expected
to grow/change." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="6519" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="204" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="198" target="203"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="205" value="DBR-ART-002 — DBR-ART-002 Each variant selects
**exactly one** of the 6 artifacts." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="6574" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="206" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="198" target="205"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="207" value="DBR-ART-003 — DBR-ART-003 Each variant stores
a **full artifact config** (selected
unlocks/mods) and equip **applies** them." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="6618" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="208" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="198" target="207"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="209" value="DBR-FASH-001 — DBR-FASH-001 Fashion/cosmetics
are part of **full equip** and DIM export when
specified." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="6673" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="210" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="198" target="209"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="211" value="DBR-FASH-002 — DBR-FASH-002 Fashion attaches
**per variant** (Fashion Sets)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="6728" width="300" height="36" as="geometry"/></mxCell>
