        <mxCell id="39" value="BR-CAT-007 — BR-CAT-007 Catalog results may
**group by** one or more dimensions (element,
ammo, archetype, frame, slot, class) for
browse; group-by does not replace filter
semantics." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1363" width="300" height="69" as="geometry"/></mxCell>
