        <mxCell id="213" value="DBR-FASH-003 — DBR-FASH-003 Fashion layer may
include shaders/ornaments, **ghost, sparrow,
ship, emblem**, and **finisher**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="6772" width="300" height="47" as="geometry"/></mxCell>
