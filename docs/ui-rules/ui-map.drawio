  <diagram id="build" name="Build">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="19201" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#e2b714;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="3" value="Structure SSoT for surfaces, flows, and rule attachments across platforms. Rule
wording lives in specs/domain-*.md and business-rules.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="380" y="24" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="4" value="Cross-set slot conflict / save blocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d0000;fontColor=#ffcccc;strokeColor=#ff6b6b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="5" value="BR-CONF-001 — BR-CONF-001 Multiple attached
sets must not assign two items to the same
slot." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="7" value="BR-CONF-002 — BR-CONF-002 Slot conflict blocks
save until resolved." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="155" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="9" value="BR-CONF-003 — BR-CONF-003 Error code:
`SLOT_CONFLICT`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="199" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="11" value="DBR-CMP-006 — DBR-CMP-006 Cross-set slot
conflicts still block save until resolved." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="243" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="13" value="DAC-DST-009 — UI prevention of hard
composition constraints **Given** a user
composing a Set (slot fill) or Build/variant
(equipment, exotics, kit, mods) **When** an
action would violate a Destiny hard rule
(illegal set slot item, **second exotic in a
weapon/armor set**, dual exotic on a variant,
slot conflict, illegal kit, mod energy, exotic
ability mismatch) **Then** the normal UI
filters or blocks the action with
plain-language reasons **And** the API still
rejects the same invalid payload if submitted
--- ## Naming &amp; browsing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="287" width="300" height="157" as="geometry"/></mxCell>
        <mxCell id="14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="15" value="BR-UI-001 — BR-UI-001 **UI prevents Destiny
hard constraints** for Sets and Builds:
illegal set slot items are not completable via
normal fill; **set-wide exotic exclusivity**
(≤1 exotic weapon per weapon set, ≤1 exotic
armor per armor set); dual exotic on builds;
occupied set slots require replace confirm;
**aspect/fragment capacity**, **armor mod
energy**, and **exotic ability requirements**
when known. Soft guidance remains
non-blocking. **API remains authoritative**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="452" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="17" value="Create Build (draft composer)
[signed-in]
/build
📷 build-create-draft-general, build-create-draft-locked-tabs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="368" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="18" value="DAC-P1-001 — Intent to designated Synergy
Types **Given** a signed-in user starting a
new Build **When** they state intent via
controlled vocabulary (Synergy Types: type +
optional subType) **Then** the user designates
≥1 Synergy Type (library Synergy records are
not required to save) **And** the system
bridges designations to matching curated
Synergies (Type + Object) for
coverage/suggestions when present **And** when
a designated verb implies an element, that
element is included in effective bridging
without requiring a separate element
designation **And** save is rejected with
`NO_SYNERGY` if zero Synergy Types are
designated" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="368" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="20" value="DAC-P1-002 — Build identity established
**Given** designated Synergy Types (and
optional exotic armor item / build-shared
exotic weapon / build-pinned Super) **When**
the user saves the Build **Then** those fields
form build identity **And** concept tags may
be set for filtering only without becoming
identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="566" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="22" value="DAC-P2-005 — In-flow create still works
**Given** a thin library **When** the user
composes a build **Then** they can create
needed synergies/sets during compose without a
hard library gate --- ## Variants &amp; identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="676" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="24" value="DBR-PUR-004 — DBR-PUR-004 Users may create
synergies and sets **in-flow** during compose;
a deep library is not a hard gate to start
composing." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="753" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="26" value="DBR-SYN-002 — DBR-SYN-002 Builds are created
**intent-first**: user designates **Synergy
Types** (`type` + optional `subType` only —
e.g. Verb: Devour, Melee, Primary Weapon). The
system **bridges** those Types to matching
curated Synergies (Type + Object) for coverage
and suggestions. A library Synergy need not
exist for a Type designation to be valid." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="819" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="28" value="DBR-SYN-003 — DBR-SYN-003 Every Build must
designate **≥1 Synergy Type** to save
(`NO_SYNERGY` otherwise)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="368" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="30" value="DBR-BLD-004 — DBR-BLD-004 Builds are
**class-bound** (Titan / Hunter / Warlock).
Character is chosen at equip time." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="423" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="32" value="BR-SAVE-003 — BR-SAVE-003 Build must designate
≥1 synergy; zero → `NO_SYNERGY`. Affirmed by
[DBR-SYN-003](./domain-business-rules.md)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="478" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="34" value="042:SC-001 — 042-create-build-pickers SC-001
After picking exotic armor or pinned super on
Create Build, a reviewer sees no search field
until Clear — 100% of those single-select
controls collapse." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="533" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="17" target="34"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="36" value="Draft General tab
📷 build-create-draft-general" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;fontColor=#e8e8e8;strokeColor=#533483;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="756" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="37" value="DAC-P1-001 — Intent to designated Synergy
Types **Given** a signed-in user starting a
new Build **When** they state intent via
controlled vocabulary (Synergy Types: type +
optional subType) **Then** the user designates
≥1 Synergy Type (library Synergy records are
not required to save) **And** the system
bridges designations to matching curated
Synergies (Type + Object) for
coverage/suggestions when present **And** when
a designated verb implies an element, that
element is included in effective bridging
without requiring a separate element
designation **And** save is rejected with
`NO_SYNERGY` if zero Synergy Types are
designated" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="756" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="36" target="37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="39" value="DAC-P1-002 — Build identity established
**Given** designated Synergy Types (and
optional exotic armor item / build-shared
exotic weapon / build-pinned Super) **When**
the user saves the Build **Then** those fields
form build identity **And** concept tags may
be set for filtering only without becoming
identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="954" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="36" target="39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="41" value="DAC-NME-001 — Default and unique names
**Given** a new build **When** saved without a
custom name **Then** a default name is derived
from Class, Element, Super, Exotic Armor,
Exotic Weapon, Synergies (omitting missing
segments) **And** manual renames are unique
per class" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="1064" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="36" target="41"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="43" value="Class picker (Titan / Hunter / Warlock)
📷 build-create-draft-general" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="1191" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="44" value="DBR-BLD-004 — DBR-BLD-004 Builds are
**class-bound** (Titan / Hunter / Warlock).
Character is chosen at equip time." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="1191" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="43" target="44"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="46" value="Exotic armor (optional identity)
📷 build-create-draft-general" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="1274" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="47" value="DBR-ID-003 — DBR-ID-003 **Exotic armor
(non–class-item)**, when set, is identity by
**item** (manifest hash), not by inventory
instance. Variants may use different owned
instances of that item." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="1274" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="46" target="47"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="49" value="DBR-ID-004 — DBR-ID-004 Exotic armor is
**optional**. When unset, identity does not
include an exotic armor item." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="1351" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="46" target="49"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="51" value="DBR-ID-005 — DBR-ID-005 **Exotic class items**
fill the exotic-armor slot but are
**intent/synergy-locked**, not
item-hash-locked. Variants may use different
class items/perks that still fit designated
synergies (soft-checked)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="1406" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="46" target="51"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="53" value="BR-BLD-003 — BR-BLD-003 **Exotic armor**
(non–class-item), when set, is build-level
identity by **item** (not instance). Exotic
class items are intent-locked and may differ
per variant within synergies. **See**
[DBR-ID-003–005](./domain-business-rules.md)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="1494" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="46" target="53"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="55" value="Exotic weapon (variant or build-shared)
📷 build-create-draft-general" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="1610" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="56" value="DBR-ID-006 — DBR-ID-006 **Exotic weapon** may
be **variant-level** or **build-shared**. When
build-shared, it is identity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="1610" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="55" target="56"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="58" value="BR-BLD-004 — BR-BLD-004 **Exotic weapon** may
be variant-level **or** build-shared
(build-shared ⇒ identity). **See**
[DBR-ID-006](./domain-business-rules.md)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="1665" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="55" target="58"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="60" value="Build name (optional; default derived)
📷 build-create-draft-general" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="1759" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="61" value="DBR-NAME-001 — DBR-NAME-001 Default Build name
is derived from: **Class, Element, Super,
Exotic Armor, Exotic Weapon, Synergies**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="1759" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="60" target="61"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="63" value="DBR-NAME-002 — DBR-NAME-002 Missing optional
segments are **omitted** (no “None”
placeholders)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="1814" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="60" target="63"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="65" value="DBR-NAME-004 — DBR-NAME-004 User may rename.
Renamed names must be **unique per class** for
that user." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="1869" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="60" target="65"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="67" value="DAC-NME-001 — Default and unique names
**Given** a new build **When** saved without a
custom name **Then** a default name is derived
from Class, Element, Super, Exotic Armor,
Exotic Weapon, Synergies (omitting missing
segments) **And** manual renames are unique
per class" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="1924" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="60" target="67"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="69" value="Build-pinned Super (optional)
📷 build-create-draft-general" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="2051" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="70" value="DBR-ID-007 — DBR-ID-007 **Super** is normally
**variant-level**. It may be **build-pinned**;
when pinned, it is identity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2051" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="69" target="70"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="72" value="Subclass / element tree
📷 build-create-draft-general" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="2134" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="73" value="DBR-SUB-001 — DBR-SUB-001 **Subclass
element/tree** is shared across all variants
(Solar, Arc, Void, Stasis, Strand, Prismatic)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2134" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="74" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="72" target="73"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="75" value="DBR-SUB-002 — DBR-SUB-002 **Prismatic** uses
the same rules as other trees — no special
identity model." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2189" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="72" target="75"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="77" value="Create / save draft
📷 build-create-draft-general" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="2272" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="78" value="DAC-P1-002 — Build identity established
**Given** designated Synergy Types (and
optional exotic armor item / build-shared
exotic weapon / build-pinned Super) **When**
the user saves the Build **Then** those fields
form build identity **And** concept tags may
be set for filtering only without becoming
identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2272" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="77" target="78"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="80" value="DBR-SYN-003 — DBR-SYN-003 Every Build must
designate **≥1 Synergy Type** to save
(`NO_SYNERGY` otherwise)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2382" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="77" target="80"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="82" value="BR-SAVE-003 — BR-SAVE-003 Build must designate
≥1 synergy; zero → `NO_SYNERGY`. Affirmed by
[DBR-SYN-003](./domain-business-rules.md)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2437" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="77" target="82"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="84" value="Synergy Type multi-select (≥1 required)
📷 build-create-draft-general" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="2520" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="85" value="DAC-P1-001 — Intent to designated Synergy
Types **Given** a signed-in user starting a
new Build **When** they state intent via
controlled vocabulary (Synergy Types: type +
optional subType) **Then** the user designates
≥1 Synergy Type (library Synergy records are
not required to save) **And** the system
bridges designations to matching curated
Synergies (Type + Object) for
coverage/suggestions when present **And** when
a designated verb implies an element, that
element is included in effective bridging
without requiring a separate element
designation **And** save is rejected with
`NO_SYNERGY` if zero Synergy Types are
designated" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2520" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="84" target="85"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="87" value="DBR-SYN-002 — DBR-SYN-002 Builds are created
**intent-first**: user designates **Synergy
Types** (`type` + optional `subType` only —
e.g. Verb: Devour, Melee, Primary Weapon). The
system **bridges** those Types to matching
curated Synergies (Type + Object) for coverage
and suggestions. A library Synergy need not
exist for a Type designation to be valid." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2718" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="84" target="87"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="89" value="DBR-SYN-003 — DBR-SYN-003 Every Build must
designate **≥1 Synergy Type** to save
(`NO_SYNERGY` otherwise)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2828" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="84" target="89"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="91" value="DBR-SYN-004 — DBR-SYN-004 Multiple designated
Synergy Types contribute **equally** to
suggestions and coverage. Soft UI nudge toward
roughly **2–5**; no hard maximum. Matched
library Synergies for the same Type are
**unioned** (equal weight)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2883" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="84" target="91"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="93" value="DBR-SYN-013 — DBR-SYN-013 When a build
designates a **verb** with a known element
alignment (e.g. Ionic Trace → Arc, Jolt →
Arc), the system may **imply** the matching
**element** designation for bridging,
matching, and coverage — without requiring the
user to also designate Element explicitly.
Explicit element designations still take
precedence when present." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2971" width="300" height="113" as="geometry"/></mxCell>
        <mxCell id="94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="84" target="93"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="95" value="BR-SAVE-003 — BR-SAVE-003 Build must designate
≥1 synergy; zero → `NO_SYNERGY`. Affirmed by
[DBR-SYN-003](./domain-business-rules.md)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="696" y="2520" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="84" target="95"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="97" value="Concept tags (filter only)
📷 build-create-draft-general" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="2788" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="98" value="DBR-ID-002 — DBR-ID-002 **Concept tags are not
identity**. Tags are optional filter metadata
(e.g. PVE, Dungeon) when no synergy covers
that context. Changing tags does not fork
identity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2788" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="97" target="98"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="100" value="BR-TAG-001 — BR-TAG-001 Sets and Builds carry
**zero or more concept tags** from a
system-defined vocabulary — not user-typed
strings." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2865" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="97" target="100"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="102" value="BR-TAG-005 — BR-TAG-005 Tag assignment is
**multi-select** on create/edit via
`ConceptTagPicker`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2931" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="97" target="102"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="104" value="BR-TAG-006 — BR-TAG-006 Builds use the **same
concept tag vocabulary** as Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="2986" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="97" target="104"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="106" value="DAC-NME-002 — Tag filter without identity
**Given** builds tagged PVE or Dungeon without
matching synergies **When** the user filters
by those tags **Then** matching builds appear
**And** changing tags does not trigger
identity confirm/fork" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="3030" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="97" target="106"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="108" value="Tab strip (locks before class/subclass)
📷 build-create-draft-locked-tabs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="3146" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="109" value="Tab — Armor (locked)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="3216" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="110" value="Tab — Finish (locked)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="3280" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="111" value="Tab — General" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="3344" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="112" value="Tab — Subclass (locked)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="3408" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="113" value="Tab — Weapon (locked)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="3472" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="114" value="New build → draft General
📷 build-create-draft-general" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="3536" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="115" value="Locked compose tabs
📷 build-create-draft-locked-tabs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="3606" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="116" value="Edit — Armor / Mod sets
[signed-in]
/build
📷 build-edit-armor-reuse, build-edit-armor-create, build-edit-armor-improve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="3676" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="117" value="DAC-P1-004 — Compose via sets with overrides
**Given** a variant under edit **When** the
user attaches Sets (live by default) and/or
pins slot overrides **Then** the variant
resolves to a coherent loadout without
unresolved slot conflicts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="3676" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="116" target="117"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="119" value="DBR-CMP-001 — DBR-CMP-001 **Sets are the
normal composition path** (Weapon, Armor, Mod,
Pair, Fashion)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="3764" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="116" target="119"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="121" value="DBR-CMP-005 — DBR-CMP-005 **Mods** come from
**Mod Sets attached per variant**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="3819" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="116" target="121"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="123" value="DBR-CMP-007 — DBR-CMP-007 At most **one exotic
weapon** and **one exotic armor** (including
exotic class item) — **hard on save**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="3863" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="116" target="123"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="125" value="BR-ATT-001 — BR-ATT-001 Users attach one or
more Sets to a Build variant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="3918" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="116" target="125"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="127" value="BR-ATT-002 — BR-ATT-002 Attachment mode:
**live** (default) or **snapshot**, per
variant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="3962" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="116" target="127"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="129" value="BR-BLD-007 — BR-BLD-007 Production Builds
provides a **guided finish walkthrough**
(Armor → Weapons → Mods): create empty Set +
live attach (replace-by-type), link existing,
capture-from-build when resolved gear exists,
fill slots from Builds; Skip for now does not
satisfy. **v1 shipped in 028.**" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="4017" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="116" target="129"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="131" value="Armor Create + attach
[signed-in]
/build
📷 build-edit-armor-create" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;fontColor=#e8e8e8;strokeColor=#533483;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="4144" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="132" value="DAC-P2-005 — In-flow create still works
**Given** a thin library **When** the user
composes a build **Then** they can create
needed synergies/sets during compose without a
hard library gate --- ## Variants &amp; identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4144" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="131" target="132"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="134" value="DBR-PUR-004 — DBR-PUR-004 Users may create
synergies and sets **in-flow** during compose;
a deep library is not a hard gate to start
composing." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4221" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="131" target="134"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="136" value="BR-BLD-007 — BR-BLD-007 Production Builds
provides a **guided finish walkthrough**
(Armor → Weapons → Mods): create empty Set +
live attach (replace-by-type), link existing,
capture-from-build when resolved gear exists,
fill slots from Builds; Skip for now does not
satisfy. **v1 shipped in 028.**" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4287" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="131" target="136"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="138" value="BR-SET-001 — BR-SET-001 Users can create,
name, tag, edit, view, and delete Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4386" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="131" target="138"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="140" value="Create set + attach form" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="4458" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="141" value="BR-SET-002 — BR-SET-002 Set types are
distinct: **Weapon**, **Armor**, **Mod**,
**Pair**, **Fashion**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="4458" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="140" target="141"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="143" value="BR-TAG-005 — BR-TAG-005 Tag assignment is
**multi-select** on create/edit via
`ConceptTagPicker`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="4513" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="140" target="143"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="145" value="BR-BLD-008 — BR-BLD-008 Finish primary path is
**slot-first**: one-tap Create (inherited
name, category type, no tags) or preferred
Capture, then first empty required slot fill
loop. Finish does not require
link/name/type/tag chrome; variant Sets tab
retains advanced create/link." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="4568" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="146" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="140" target="145"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="147" value="Single exotic armor hard gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d0000;fontColor=#ffcccc;strokeColor=#ff6b6b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="4695" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="148" value="DBR-CMP-007 — DBR-CMP-007 At most **one exotic
weapon** and **one exotic armor** (including
exotic class item) — **hard on save**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4695" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="149" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="147" target="148"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="150" value="DAC-DST-001 — Exotic limits **Given** a
variant that would equip two exotic weapons or
two exotic armor pieces **When** the user
saves **Then** save is rejected **And** the
normal UI prevents selecting / completing the
second exotic when composition is known" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4750" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="151" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="147" target="150"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="152" value="DAC-DST-009 — UI prevention of hard
composition constraints **Given** a user
composing a Set (slot fill) or Build/variant
(equipment, exotics, kit, mods) **When** an
action would violate a Destiny hard rule
(illegal set slot item, **second exotic in a
weapon/armor set**, dual exotic on a variant,
slot conflict, illegal kit, mod energy, exotic
ability mismatch) **Then** the normal UI
filters or blocks the action with
plain-language reasons **And** the API still
rejects the same invalid payload if submitted
--- ## Naming &amp; browsing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4838" width="300" height="157" as="geometry"/></mxCell>
        <mxCell id="153" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="147" target="152"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="154" value="Mod set coverage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="5031" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="155" value="DBR-CMP-005 — DBR-CMP-005 **Mods** come from
**Mod Sets attached per variant**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="5031" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="156" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="154" target="155"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="157" value="DBR-MOD-001 — DBR-MOD-001 Illegal or
over-capacity mod loadouts **cannot be
saved**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="5075" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="158" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="154" target="157"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="159" value="DBR-MOD-002 — DBR-MOD-002 Armor energy
capacity: **Tier ≤4 → 10**; **Tier 5 → 11**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="5130" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="160" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="154" target="159"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="161" value="DBR-MOD-003 — DBR-MOD-003 Armor **tier** is an
instance/validation concern (capacity +
suggestions), not build identity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="5174" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="162" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="154" target="161"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="163" value="DAC-DST-002 — Mod energy **Given** armor tier
≤4 (10 energy) or tier 5 (11 energy) **When**
mods exceed capacity or are illegal for the
piece **Then** save is rejected **And** the
Mods UI shows remaining energy and refuses
over-cap picks when cost is known" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="5229" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="164" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="154" target="163"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="165" value="Energy remaining / over-cap block" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="5345" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="166" value="DAC-DST-002 — Mod energy **Given** armor tier
≤4 (10 energy) or tier 5 (11 energy) **When**
mods exceed capacity or are illegal for the
piece **Then** save is rejected **And** the
Mods UI shows remaining energy and refuses
over-cap picks when cost is known" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="5345" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="167" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="165" target="166"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="168" value="DBR-MOD-001 — DBR-MOD-001 Illegal or
over-capacity mod loadouts **cannot be
saved**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="5433" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="169" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="165" target="168"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="170" value="BR-UI-001 — BR-UI-001 **UI prevents Destiny
hard constraints** for Sets and Builds:
illegal set slot items are not completable via
normal fill; **set-wide exotic exclusivity**
(≤1 exotic weapon per weapon set, ≤1 exotic
armor per armor set); dual exotic on builds;
occupied set slots require replace confirm;
**aspect/fragment capacity**, **armor mod
energy**, and **exotic ability requirements**
when known. Soft guidance remains
non-blocking. **API remains authoritative**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="5488" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="171" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="165" target="170"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="172" value="Armor Reuse (attach existing)
[signed-in]
/build
📷 build-edit-armor-reuse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;fontColor=#e8e8e8;strokeColor=#533483;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="5659" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="173" value="BR-ATT-001 — BR-ATT-001 Users attach one or
more Sets to a Build variant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="5659" width="300" height="36" as="geometry"/></mxCell>
