        <mxCell id="18" value="BR-AUTH-001 — BR-AUTH-001 Sets, Synergies,
Builds APIs require authenticated user." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="450" width="300" height="36" as="geometry"/></mxCell>
