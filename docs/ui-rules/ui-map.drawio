        <mxCell id="74" value="Edit set form
[signed-in]
/sets
📷 sets-edit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2677" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="75" value="BR-SET-001 — BR-SET-001 Users can create,
name, tag, edit, view, and delete Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="2677" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="74" target="75"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="77" value="BR-TAG-005 — BR-TAG-005 Tag assignment is
**multi-select** on create/edit via
`ConceptTagPicker`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="2721" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="74" target="77"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="79" value="BR-SLOT-001 — BR-SLOT-001 **Weapon Sets**: at
most 0 or 1 item per primary, special, heavy." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="2776" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="74" target="79"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="81" value="Name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="2848" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="82" value="Slot cardinality / items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="2912" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="83" value="BR-SLOT-001 — BR-SLOT-001 **Weapon Sets**: at
most 0 or 1 item per primary, special, heavy." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="2912" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="82" target="83"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="85" value="BR-SLOT-002 — BR-SLOT-002 **Armor Sets**: at
most 0 or 1 item per helmet, arms, chest,
legs, class item." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="2956" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="82" target="85"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="87" value="BR-SLOT-003 — BR-SLOT-003 **Pair Sets**: at
most 0 or 1 exotic weapon and 0 or 1 exotic
armor." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="3011" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="82" target="87"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="89" value="BR-SLOT-004 — BR-SLOT-004 **Mod Sets**: mods
optional but encouraged; not required for
valid set." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="3066" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="82" target="89"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="91" value="BR-SLOT-005 — BR-SLOT-005 Any slot within a
set&apos;s domain **may be left empty**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="3121" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="82" target="91"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="93" value="BR-SLOT-006 — BR-SLOT-006 Adding to an
**occupied slot** requires confirmation, then
replaces the item." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="3165" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="82" target="93"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="95" value="BR-SLOT-007 — BR-SLOT-007 Mod Sets and armor
sets with empty mod slots MUST show UI
encouragement to add mods; mods remain
optional for save." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="3220" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="82" target="95"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="97" value="BR-SLOT-008 — BR-SLOT-008 **Weapon Sets**: at
most **one exotic weapon** across all slots
(kit must stay attachable without
dual-exotic). Replacing the slot that holds
the exotic is allowed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="3286" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="82" target="97"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="99" value="BR-SLOT-009 — BR-SLOT-009 **Armor Sets**: at
most **one exotic armor** (including exotic
class item) across all slots. Replacing the
exotic piece’s slot is allowed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="3363" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="82" target="99"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="101" value="BR-SLOT-010 — BR-SLOT-010 **Mod Sets** are
organized **per armor piece** (helmet, arms,
chest, legs, class item). Multiple plugs per
piece are allowed within **energy capacity**
(10 default; 11 when tier 5 known).
Slot-scoped mods must match the piece;
**general** / **tuning** mods may sit on any
piece. Storage key: `{armorSlot}:{itemHash}`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="666" y="2912" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="102" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="82" target="101"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="103" value="DAC-DST-009 — UI prevention of hard
composition constraints **Given** a user
composing a Set (slot fill) or Build/variant
(equipment, exotics, kit, mods) **When** an
action would violate a Destiny hard rule
(illegal set slot item, **second exotic in a
weapon/armor set**, dual exotic on a variant,
slot conflict, illegal kit, mod energy, exotic
ability mismatch) **Then** the normal UI
filters or blocks the action with
plain-language reasons **And** the API still
rejects the same invalid payload if submitted
--- ## Naming &amp; browsing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="666" y="3022" width="300" height="157" as="geometry"/></mxCell>
        <mxCell id="104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="82" target="103"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="105" value="Tags" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="3380" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="106" value="Fashion set fields" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="3444" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="107" value="BR-FASH-001 — BR-FASH-001 Fashion Sets are
cosmetic/organizational (not identity)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="3444" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="106" target="107"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="109" value="BR-FASH-002 — BR-FASH-002 Fashion Sets must
not participate in synergies, suggestions, or
stats." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="3488" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="106" target="109"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="111" value="BR-FASH-003 — BR-FASH-003 Fashion is resolved
on the variant fashion layer for equip/export;
still excluded from combat synergy/stat
resolution. **See**
[DBR-FASH-*](./domain-business-rules.md)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="3543" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="112" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="106" target="111"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="113" value="DBR-FASH-001 — DBR-FASH-001 Fashion/cosmetics
are part of **full equip** and DIM export when
specified." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="3620" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="106" target="113"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="115" value="Fill slot (embedded Catalog)
[signed-in]
/sets
📷 sets-fill-slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="3703" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="116" value="DAC-NME-003 — Catalog multi-facet browse
**Given** a user browsing weapons or armor in
Catalog (including set-fill constrained pick)
**When** they combine free-text with
multi-value facets (e.g. element, ammo,
archetype) including include and exclude
**Then** results respect OR-within-facet,
AND-across-facets, and exclude-drop semantics
**And** optional group-by dimensions partition
the result list without changing filter
semantics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="3703" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="115" target="116"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="118" value="DBR-ROLL-010 — DBR-ROLL-010 Catalog **browse**
for composition supports multi-dimension
filtering (e.g. element, ammo,
archetype/frame, slot, class, exotic
constraint, free-text, optional synergy
membership) with **include OR within a
facet**, **AND across facets**, and
**exclude** drops; optional **group-by** one
or more dimensions for browse. Catalog is a
composition aid, not a separate product job
(see DBR-PUR-002)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="3846" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="115" target="118"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="120" value="DAC-DST-009 — UI prevention of hard
composition constraints **Given** a user
composing a Set (slot fill) or Build/variant
(equipment, exotics, kit, mods) **When** an
action would violate a Destiny hard rule
(illegal set slot item, **second exotic in a
weapon/armor set**, dual exotic on a variant,
slot conflict, illegal kit, mod energy, exotic
ability mismatch) **Then** the normal UI
filters or blocks the action with
plain-language reasons **And** the API still
rejects the same invalid payload if submitted
--- ## Naming &amp; browsing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="3989" width="300" height="157" as="geometry"/></mxCell>
        <mxCell id="121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="115" target="120"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="122" value="BR-SLOT-008 — BR-SLOT-008 **Weapon Sets**: at
most **one exotic weapon** across all slots
(kit must stay attachable without
dual-exotic). Replacing the slot that holds
the exotic is allowed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="4154" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="115" target="122"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="124" value="BR-SLOT-009 — BR-SLOT-009 **Armor Sets**: at
most **one exotic armor** (including exotic
class item) across all slots. Replacing the
exotic piece’s slot is allowed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="3703" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="115" target="124"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="126" value="BR-UI-001 — BR-UI-001 **UI prevents Destiny
hard constraints** for Sets and Builds:
illegal set slot items are not completable via
normal fill; **set-wide exotic exclusivity**
(≤1 exotic weapon per weapon set, ≤1 exotic
armor per armor set); dual exotic on builds;
occupied set slots require replace confirm;
**aspect/fragment capacity**, **armor mod
energy**, and **exotic ability requirements**
when known. Soft guidance remains
non-blocking. **API remains authoritative**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="3769" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="115" target="126"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="128" value="Constrained catalog pick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="3971" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="129" value="DAC-NME-003 — Catalog multi-facet browse
**Given** a user browsing weapons or armor in
Catalog (including set-fill constrained pick)
**When** they combine free-text with
multi-value facets (e.g. element, ammo,
archetype) including include and exclude
**Then** results respect OR-within-facet,
AND-across-facets, and exclude-drop semantics
**And** optional group-by dimensions partition
the result list without changing filter
semantics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="3971" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="128" target="129"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="131" value="Second exotic blocked in set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d0000;fontColor=#ffcccc;strokeColor=#ff6b6b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="4142" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="132" value="BR-SLOT-008 — BR-SLOT-008 **Weapon Sets**: at
most **one exotic weapon** across all slots
(kit must stay attachable without
dual-exotic). Replacing the slot that holds
the exotic is allowed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4142" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="131" target="132"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="134" value="BR-SLOT-009 — BR-SLOT-009 **Armor Sets**: at
most **one exotic armor** (including exotic
class item) across all slots. Replacing the
exotic piece’s slot is allowed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4219" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="131" target="134"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="136" value="DAC-DST-001 — Exotic limits **Given** a
variant that would equip two exotic weapons or
two exotic armor pieces **When** the user
saves **Then** save is rejected **And** the
normal UI prevents selecting / completing the
second exotic when composition is known" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4285" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="131" target="136"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="138" value="DAC-DST-009 — UI prevention of hard
composition constraints **Given** a user
composing a Set (slot fill) or Build/variant
(equipment, exotics, kit, mods) **When** an
action would violate a Destiny hard rule
(illegal set slot item, **second exotic in a
weapon/armor set**, dual exotic on a variant,
slot conflict, illegal kit, mod energy, exotic
ability mismatch) **Then** the normal UI
filters or blocks the action with
plain-language reasons **And** the API still
rejects the same invalid payload if submitted
--- ## Naming &amp; browsing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4373" width="300" height="157" as="geometry"/></mxCell>
        <mxCell id="139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="131" target="138"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="140" value="Sets library
[signed-in]
/sets
📷 sets-library" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="4566" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="141" value="BR-SET-001 — BR-SET-001 Users can create,
name, tag, edit, view, and delete Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="4566" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="140" target="141"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="143" value="BR-SET-002 — BR-SET-002 Set types are
distinct: **Weapon**, **Armor**, **Mod**,
**Pair**, **Fashion**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="4610" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="140" target="143"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="145" value="BR-SET-003 — BR-SET-003 Sets are **private per
user**; no sharing in initial scope." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="4665" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="146" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="140" target="145"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="147" value="BR-TAG-008 — BR-TAG-008 Tag filter is
available in **SetAttachPicker**, **Sets
list**, and **Builds list**; empty state when
no matches." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="4709" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="148" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="140" target="147"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="149" value="DAC-P1-009 — Library bar for P1 done **Given**
P1 compose+equip works **When** evaluating
domain “done” for the primary journey **Then**
the account also has ≥10 synergies and ≥10
sets spanning weapon/armor/mod (ideally pair
or fashion) --- ## P2 — Library curation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="4775" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="150" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="140" target="149"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="151" value="DBR-PUR-005 — DBR-PUR-005 Library readiness
bar for the primary journey: at least **≥10
synergies** and **≥10 sets** spanning
weapon/armor/mod (ideally including pair or
fashion)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="4863" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="152" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="140" target="151"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="153" value="001:SC-001 — 001-build-sets-synergies SC-001 A
user can create a new categorized set
containing at least 3 items in under 60
seconds." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="4940" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="154" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="140" target="153"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="155" value="001:SC-002 — 001-build-sets-synergies SC-002
Sets or synergies can be located using search
or concept tag filters in under 5 seconds." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="5006" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="156" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="140" target="155"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="157" value="Concept tag filter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="4914" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="158" value="BR-TAG-007 — BR-TAG-007 Multi-tag filter uses
**AND semantics**: `Solar` + `Melee` returns
only entities with **both** tags." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4914" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="159" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="157" target="158"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="160" value="BR-TAG-008 — BR-TAG-008 Tag filter is
available in **SetAttachPicker**, **Sets
list**, and **Builds list**; empty state when
no matches." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="4969" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="161" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="157" target="160"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="162" value="Filter by set type" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="5063" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="163" value="BR-SET-002 — BR-SET-002 Set types are
distinct: **Weapon**, **Armor**, **Mod**,
**Pair**, **Fashion**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="5063" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="164" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="162" target="163"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="165" value="New Set" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="5146" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="166" value="Search by name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="5210" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="167" value="Armor set optimize (library)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="5274" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="168" value="BR-OPT-001 — BR-OPT-001 Create-from-build and
first-time materialize with **attach-now** use
**replace-by-type**: detach existing live
attachment(s) of the **same set type** on the
variant, then attach the new Set(s). Other
types unchanged; detached Sets remain in the
library. Names auto-suffix on collision." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="5274" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="169" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="167" target="168"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="170" value="BR-OPT-002 — BR-OPT-002 Armor Sets MAY store
**`optimizerConstraints`** (JSON): exotic
lock, set-bonus goals, ordered stat
priorities/thresholds, mod-aware flag,
**`preferReuse`** (default false).
Create-from-build **seeds** exotic + soft-stat
fields (empty set-bonus goals). First
materialize **persists** search constraints;
refresh **updates items in place** without
changing constraints unless the user
edits/saves or **clears** them (clear opts out
of improvement checks)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="5373" width="300" height="146" as="geometry"/></mxCell>
        <mxCell id="171" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="167" target="170"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="172" value="026:SC-001 — 026-armor-set-optimizer SC-001
From a Build with a filled armor loadout, a
user can create and attach an Armor Set in one
flow in under 1 minute (excluding inventory
sync time)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="5527" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="173" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="167" target="172"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="174" value="Pair set exotic constraints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="5632" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="175" value="BR-PAIR-001 — BR-PAIR-001 Pair Set exotic
armor must match build exotic armor." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="5632" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="176" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="174" target="175"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="177" value="BR-PAIR-002 — BR-PAIR-002 Mismatch →
`PAIR_ARMOR_MISMATCH`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="5676" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="178" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="174" target="177"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="179" value="BR-PAIR-003 — BR-PAIR-003 Pair Set primarily
supplies variant exotic weapon." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="5720" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="180" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="174" target="179"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="181" value="DBR-CMP-004 — DBR-CMP-004 **Pair Sets** are
optional convenience packages for exotic
combos; exotics may also be set directly or
via other sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="5764" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="182" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="174" target="181"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="183" value="Sets — signed-out gate
[signed-out]
/sets
📷 sets-signed-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d0000;fontColor=#ffcccc;strokeColor=#ff6b6b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="5858" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="184" value="BR-AUTH-001 — BR-AUTH-001 Sets, Synergies,
Builds APIs require authenticated user." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="5858" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="185" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="183" target="184"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="186" value="BR-SET-003 — BR-SET-003 Sets are **private per
user**; no sharing in initial scope." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="5902" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="187" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="183" target="186"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="188" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#888;endArrow=block;endFill=1;" edge="1" parent="1" source="54" target="74"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="189" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#888;endArrow=block;endFill=1;" edge="1" parent="1" source="55" target="115"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="190" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#888;endArrow=block;endFill=1;" edge="1" parent="1" source="165" target="4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="191" value="DAC (acceptance)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="5994" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="192" value="DBR (domain BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="190" y="5994" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="193" value="BR (feature BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="340" y="5994" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="194" value="Slice AC/SC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="490" y="5994" width="140" height="32" as="geometry"/></mxCell>
      </root>
