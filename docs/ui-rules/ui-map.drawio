📷 build-edit-armor-improve" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="767" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="28" value="BR-SUG-001 — BR-SUG-001 Set suggestions:
automatic (contextual) and explicit (user
action/goal)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="767" width="300" height="47" as="geometry"/></mxCell>
