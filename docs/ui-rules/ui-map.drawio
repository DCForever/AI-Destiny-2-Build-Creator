        <mxCell id="3" value="Flow flow.armor-set-compose" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="380" y="24" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="4" value="Select build
[signed-in]
/build
📷 build-library-selected" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#2d4059;fontColor=#fff;strokeColor=#ea5455;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="5" value="DBR-BLD-001 — DBR-BLD-001 A **Build** is both
a **fully equippable loadout** and a **stable
identity** with **variants**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="300" height="47" as="geometry"/></mxCell>
