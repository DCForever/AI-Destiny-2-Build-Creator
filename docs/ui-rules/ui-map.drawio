        <mxCell id="598" value="BR-VAR-003 — BR-VAR-003 Compare view
highlights set/weapon/notes differences; shows
shared fields as common." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="18880" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="599" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="591" target="598"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="600" value="Build — signed-out gate
[signed-out]
