        <mxCell id="223" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="219" target="222"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="224" value="Shaders / ornaments / flair" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="6942" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="225" value="DBR-FASH-001 — DBR-FASH-001 Fashion/cosmetics
are part of **full equip** and DIM export when
specified." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="6942" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="226" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="224" target="225"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="227" value="DAC-VAR-003 — Fashion per variant **Given** a
variant with fashion (shaders,
ghost/sparrow/ship/emblem, finisher) **When**
the user equips/exports **Then** specified
fashion applies and omitted fashion slots are
left as-is" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="6997" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="228" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="224" target="227"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="229" value="Soft guidance / coverage breakdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="7113" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="230" value="DAC-P1-006 — Soft guidance visible **Given** a
build with designated synergies and optional
soft stat targets **When** the user views a
variant **Then** they see passive indicators
and a coverage breakdown (supported / weak /
missing + hints) for synergies, stats, and
related soft checks **And** weak coverage does
not block save on non-default variants" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="7113" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="231" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="229" target="230"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="232" value="DAC-DST-005 — Soft element matching **Given**
a Solar (or other) subclass tree and
off-element weapons **When** the user views
coverage **Then** element mismatch is
soft/synergy-based, not a blanket hard block" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="7223" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="233" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="229" target="232"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="234" value="DAC-DST-006 — EoF soft stats **Given**
build-level soft targets on
Class/Grenade/Melee/Super/Health/Weapons (up
to 200) **When** a variant’s full loadout
estimate is below targets **Then** warnings
appear; save/equip still allowed **And**
synergies may nudge related targets for user
acceptance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="7300" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="235" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="229" target="234"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="236" value="DBR-GUID-001 — DBR-GUID-001 Soft guidance uses
**passive indicators** and a **coverage
breakdown** (supported / weak / missing +
hints)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="7410" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="237" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="229" target="236"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="238" value="DBR-GUID-002 — DBR-GUID-002 Suggestions
primarily optimize for **synergy coverage**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="7476" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="239" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="229" target="238"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="240" value="DBR-GUID-003 — DBR-GUID-003 Hard blocks are
reserved for true Destiny/system constraints
(exotics limits, energy, illegal kits,
ownership/pins for equip, required links on
default, etc.). Where pickers exist, **hard
constraints must not be UI-selectable**
(filter/disable illegal options); primary
Save/Create/Fill actions stay **disabled**
when hard blocks remain. Soft guidance never
disables Save on non-default variants. API
remains authoritative." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="7520" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="241" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="229" target="240"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="242" value="DBR-SYN-011 — DBR-SYN-011 Non-default variants
receive **soft guidance** for synergy coverage
(suggestions/warnings); weak coverage does not
block save." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="7113" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="243" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="229" target="242"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="244" value="DBR-STAT-004 — DBR-STAT-004 Missing targets do
not block save/equip; below-target is a
**warning** via soft guidance." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="7179" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="245" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="229" target="244"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="246" value="DAC-P2-002 — Required links on default variant
**Given** a designated synergy with required
links **When** saving the default variant
**Then** save is blocked until all required
links are satisfied **And** other variants
only soft-warn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="7234" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="247" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="229" target="246"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="248" value="DBR-SYN-010 — DBR-SYN-010 Required-link hard
checks apply to the **default variant only**;
other variants get soft warnings." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="7322" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="249" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="229" target="248"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="250" value="Default variant composer (inline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="7541" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="251" value="DAC-P1-003 — Default variant full combat
loadout **Given** the default variant **When**
the user marks it complete / saves as the
build’s default **Then** it includes class,
subclass tree, a legal subclass kit, all
weapon slots, all armor slots, and mods (via
Mod Sets / overrides) **And** illegal kits,
over-capacity mods, or &gt;1 exotic weapon/armor
cannot save" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="7541" width="300" height="113" as="geometry"/></mxCell>
        <mxCell id="252" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="250" target="251"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="253" value="DBR-CMPL-001 — DBR-CMPL-001 **Default
variant** must be a **full combat loadout**
(class, subclass kit, all weapon slots, all
armor slots, mods as part of the build)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="7662" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="254" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="250" target="253"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="255" value="BR-BLD-001 — BR-BLD-001 Build contains one
default variant and optional additional
variants." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="7728" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="256" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="250" target="255"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="257" value="043:SC-001 — 043-default-variant-composer
SC-001 A reviewer following only the tab
labels can locate Intent/Identity, Subclass
kit, Armor (reuse or create), and Weapons
without opening a separate multi-section &quot;Sets
dump&quot; as the primary path." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="7783" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="258" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="250" target="257"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="259" value="Finish readiness
📷 build-edit-finish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="7899" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="260" value="Edit — General (live identity)
[signed-in]
/build
📷 build-edit-general" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="7969" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="261" value="DAC-P1-002 — Build identity established
**Given** designated Synergy Types (and
optional exotic armor item / build-shared
exotic weapon / build-pinned Super) **When**
the user saves the Build **Then** those fields
form build identity **And** concept tags may
be set for filtering only without becoming
identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="7969" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="262" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="260" target="261"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="263" value="DAC-VAR-004 — Identity edit confirm/fork
**Given** an existing build with variants
**When** the user changes designated
synergies, set exotic armor item, build-shared
exotic weapon, or build-pinned Super **Then**
the system warns and offers confirm in-place
or fork" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="8079" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="264" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="260" target="263"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="265" value="DBR-ID-008 — DBR-ID-008 Changing identity
fields requires **confirm in-place** (affects
all variants) or **fork** to a new Build." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="8178" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="266" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="260" target="265"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="267" value="DBR-ID-009 — DBR-ID-009 Identity fields
include: designated synergies; exotic armor
item when set; build-shared exotic weapon when
set; build-pinned Super when set." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="8233" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="268" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="260" target="267"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="269" value="DBR-NAME-004 — DBR-NAME-004 User may rename.
Renamed names must be **unique per class** for
that user." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="8299" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="270" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="260" target="269"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="271" value="Identity fields" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="8382" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="272" value="DBR-ID-001 — DBR-ID-001 **Primary identity**
is **designated synergies** (curated
play-patterns / verbs/goals)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="8382" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="273" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="271" target="272"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="274" value="DBR-ID-009 — DBR-ID-009 Identity fields
include: designated synergies; exotic armor
item when set; build-shared exotic weapon when
set; build-pinned Super when set." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="8437" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="275" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="271" target="274"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="276" value="DAC-VAR-004 — Identity edit confirm/fork
**Given** an existing build with variants
**When** the user changes designated
synergies, set exotic armor item, build-shared
exotic weapon, or build-pinned Super **Then**
the system warns and offers confirm in-place
or fork" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="8503" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="277" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="271" target="276"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="278" value="Exotic armor item" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="8630" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="279" value="DBR-ID-003 — DBR-ID-003 **Exotic armor
(non–class-item)**, when set, is identity by
**item** (manifest hash), not by inventory
instance. Variants may use different owned
instances of that item." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="8630" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="280" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="278" target="279"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="281" value="DBR-ID-005 — DBR-ID-005 **Exotic class items**
fill the exotic-armor slot but are
**intent/synergy-locked**, not
item-hash-locked. Variants may use different
class items/perks that still fit designated
synergies (soft-checked)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="8707" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="282" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="278" target="281"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="283" value="DAC-VAR-005 — Exotic class item within intent
**Given** a build whose exotic slot is an
exotic class item **When** variants use
different class items/perk configs that still
fit designated synergies **Then** save is
allowed with soft coverage guidance **And**
each variant stores full class-item perk
config" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="8795" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="284" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="278" target="283"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="285" value="DAC-VAR-006 — Classic exotic armor item lock
**Given** a build with Felwinter’s Helm (or
similar) set as exotic armor identity **When**
variants pin different owned instances of that
item **Then** identity remains the same item
**And** changing to a different exotic armor
item requires identity confirm/fork --- ##
Destiny constraints" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="8905" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="286" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="278" target="285"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="287" value="Build-shared exotic weapon" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="9043" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="288" value="DBR-ID-006 — DBR-ID-006 **Exotic weapon** may
be **variant-level** or **build-shared**. When
build-shared, it is identity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="9043" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="289" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="287" target="288"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="290" value="Build-pinned Super" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="9126" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="291" value="DBR-ID-007 — DBR-ID-007 **Super** is normally
**variant-level**. It may be **build-pinned**;
when pinned, it is identity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="9126" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="292" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="290" target="291"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="293" value="Designated Synergy Types" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="9209" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="294" value="DBR-SYN-002 — DBR-SYN-002 Builds are created
**intent-first**: user designates **Synergy
Types** (`type` + optional `subType` only —
e.g. Verb: Devour, Melee, Primary Weapon). The
system **bridges** those Types to matching
curated Synergies (Type + Object) for coverage
and suggestions. A library Synergy need not
exist for a Type designation to be valid." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="9209" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="295" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="293" target="294"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="296" value="DBR-SYN-003 — DBR-SYN-003 Every Build must
designate **≥1 Synergy Type** to save
(`NO_SYNERGY` otherwise)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="9319" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="297" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="293" target="296"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="298" value="DBR-SYN-004 — DBR-SYN-004 Multiple designated
Synergy Types contribute **equally** to
suggestions and coverage. Soft UI nudge toward
roughly **2–5**; no hard maximum. Matched
library Synergies for the same Type are
**unioned** (equal weight)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="9374" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="299" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="293" target="298"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="300" value="DBR-ID-001 — DBR-ID-001 **Primary identity**
is **designated synergies** (curated
play-patterns / verbs/goals)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="9462" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="301" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="293" target="300"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="302" value="Rename build (unique per class)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="9545" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="303" value="DBR-NAME-004 — DBR-NAME-004 User may rename.
Renamed names must be **unique per class** for
that user." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="9545" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="304" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="302" target="303"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="305" value="DAC-NME-001 — Default and unique names
**Given** a new build **When** saved without a
custom name **Then** a default name is derived
from Class, Element, Super, Exotic Armor,
Exotic Weapon, Synergies (omitting missing
segments) **And** manual renames are unique
per class" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="9600" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="306" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="302" target="305"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="307" value="Build notes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="9727" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="308" value="DBR-BLD-006 — DBR-BLD-006 Builds and variants
may have free-form **notes** (not identity)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="9727" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="309" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="307" target="308"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="310" value="Soft stat targets editor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="9799" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="311" value="DAC-DST-006 — EoF soft stats **Given**
build-level soft targets on
Class/Grenade/Melee/Super/Health/Weapons (up
to 200) **When** a variant’s full loadout
estimate is below targets **Then** warnings
appear; save/equip still allowed **And**
synergies may nudge related targets for user
acceptance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="9799" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="312" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="310" target="311"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="313" value="DBR-STAT-001 — DBR-STAT-001 Soft stat targets
use the EoF six: **Class, Grenade, Melee,
Super, Health, Weapons**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="9909" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="314" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="310" target="313"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="315" value="DBR-STAT-002 — DBR-STAT-002 Targets are
optional **per-stat thresholds** at **build
level** (shared across variants)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="9964" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="316" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="310" target="315"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="317" value="DBR-STAT-003 — DBR-STAT-003 Valid target range
supports benefits up to **200** (max for
benefits)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="10019" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="318" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="310" target="317"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="319" value="DBR-STAT-004 — DBR-STAT-004 Missing targets do
not block save/equip; below-target is a
**warning** via soft guidance." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="10074" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="320" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="310" target="319"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="321" value="DBR-STAT-005 — DBR-STAT-005 Coverage uses a
**full loadout estimate**: armor (including
class item), mods, fragments/aspects, and
other known loadout bonuses." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="10129" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="322" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="310" target="321"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="323" value="DBR-STAT-006 — DBR-STAT-006 Designated
synergies may **suggest/nudge** related soft
stat targets; user accepts or ignores." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="10195" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="324" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="310" target="323"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="325" value="Target — Class" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="10278" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="326" value="Target — Grenade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="10342" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="327" value="Target — Health" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="10406" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="328" value="Target — Melee" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="10470" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="329" value="Target — Super" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="10534" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="330" value="Target — Weapons" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="10598" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="331" value="Concept tags" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="10662" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="332" value="DBR-ID-002 — DBR-ID-002 **Concept tags are not
identity**. Tags are optional filter metadata
(e.g. PVE, Dungeon) when no synergy covers
that context. Changing tags does not fork
identity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="10662" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="333" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="331" target="332"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="334" value="BR-TAG-006 — BR-TAG-006 Builds use the **same
concept tag vocabulary** as Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="10739" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="335" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="331" target="334"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="336" value="Per-slot pin / override" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="10811" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="337" value="DBR-CMP-002 — DBR-CMP-002 Users may also
**pin/override individual slots** on a
variant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="10811" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="338" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="336" target="337"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="339" value="DBR-ROLL-004 — DBR-ROLL-004 **Equip** requires
a **pinned owned instance** for **every
equipment slot being applied**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="10866" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="340" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="336" target="339"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="341" value="DBR-ROLL-006 — DBR-ROLL-006 If a pinned
instance disappears after sync: keep item +
desired roll, mark **stale pin**, block equip
until re-pinned." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="10921" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="342" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="336" target="341"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="343" value="DAC-DST-007 — Stale pins **Given** a pinned
instance missing after sync **When** the user
opens the variant **Then** the pin is marked
stale, desired roll retained, equip blocked
until re-pin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="10987" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="344" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="336" target="343"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="345" value="Catalyst / deepsight display" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="11092" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="346" value="DAC-DST-008 — Catalyst / deepsight display
**Given** items with catalyst or pattern state
**When** viewed on a build **Then** statuses
display (catalyst: equipped / unequipped-warn
/ unfinished-warn / unacquired; deepsight
display-only) **And** neither gates save/equip" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="11092" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="347" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="345" target="346"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="348" value="DBR-ROLL-007 — DBR-ROLL-007 **Catalysts**:
display status only — equipped; unequipped
(warn); unfinished (warn); unacquired. Do not
gate save/equip." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="11180" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="349" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="345" target="348"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="350" value="DBR-ROLL-008 — DBR-ROLL-008 **Deepsight /
pattern progress**: display-only with warns;
no save/equip gate." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="11246" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="351" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="345" target="350"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="352" value="Pin owned instance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="11329" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="353" value="DBR-ROLL-004 — DBR-ROLL-004 **Equip** requires
a **pinned owned instance** for **every
equipment slot being applied**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="11329" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="354" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="352" target="353"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="355" value="DBR-ROLL-005 — DBR-ROLL-005 Variants may be
**saved** without instance pins (wishlist OK).
Equip/export is blocked until pins exist for
applied slots." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="11384" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="356" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="352" target="355"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="357" value="Stale pin indicator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d0000;fontColor=#ffcccc;strokeColor=#ff6b6b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="11478" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="358" value="DAC-DST-007 — Stale pins **Given** a pinned
instance missing after sync **When** the user
opens the variant **Then** the pin is marked
stale, desired roll retained, equip blocked
until re-pin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="11478" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="359" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="357" target="358"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="360" value="DBR-ROLL-006 — DBR-ROLL-006 If a pinned
instance disappears after sync: keep item +
desired roll, mark **stale pin**, block equip
until re-pinned." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="11555" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="361" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="357" target="360"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="362" value="Edit — Subclass kit
[signed-in]
/build
📷 build-edit-subclass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="11649" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="363" value="DBR-SUB-001 — DBR-SUB-001 **Subclass
element/tree** is shared across all variants
(Solar, Arc, Void, Stasis, Strand, Prismatic)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="11649" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="364" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="362" target="363"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="365" value="DBR-SUB-003 — DBR-SUB-003 **Aspects,
fragments, and ability choices** may differ
per variant, except build-pinned Super /
exotic-required pinned abilities." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="11704" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="366" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="362" target="365"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="367" value="DBR-SUB-004 — DBR-SUB-004 Illegal subclass
kits (invalid combinations or over
aspect/fragment slot limits) **cannot be
saved**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="11770" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="368" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="362" target="367"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="369" value="DBR-SUB-005 — DBR-SUB-005 When an exotic
requires a specific Super / melee / grenade /
class ability, the system **auto-proposes
build-pinned abilities**; user confirms;
**mismatch blocks save**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="11836" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="370" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="362" target="369"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="371" value="DAC-DST-003 — Subclass slot limits **Given** a
subclass kit over aspect/fragment limits or
otherwise illegal **When** the user saves
**Then** save is rejected **And** the
Aspects/Fragments UI caps picks (max 2
aspects; fragments ≤ aspect capacity) when
capacity is known" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="11913" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="372" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="362" target="371"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="373" value="DAC-DST-004 — Exotic ability requirements
**Given** an exotic that requires a specific
ability (curated `exoticAbilityRequirements`)
**When** it is set on the build **Then** the
system proposes pinning that ability at build
level **And** after confirm, mismatched kits
cannot save" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="12012" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="374" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="362" target="373"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="375" value="BR-UI-001 — BR-UI-001 **UI prevents Destiny
hard constraints** for Sets and Builds:
illegal set slot items are not completable via
normal fill; **set-wide exotic exclusivity**
(≤1 exotic weapon per weapon set, ≤1 exotic
armor per armor set); dual exotic on builds;
occupied set slots require replace confirm;
**aspect/fragment capacity**, **armor mod
energy**, and **exotic ability requirements**
when known. Soft guidance remains
non-blocking. **API remains authoritative**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="12111" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="376" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="362" target="375"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="377" value="Melee / grenade / class ability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="11957" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="378" value="DBR-SUB-003 — DBR-SUB-003 **Aspects,
fragments, and ability choices** may differ
per variant, except build-pinned Super /
exotic-required pinned abilities." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="11957" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="379" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="377" target="378"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="380" value="DBR-SUB-005 — DBR-SUB-005 When an exotic
requires a specific Super / melee / grenade /
class ability, the system **auto-proposes
build-pinned abilities**; user confirms;
**mismatch blocks save**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="12023" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="381" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="377" target="380"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="382" value="DAC-DST-004 — Exotic ability requirements
**Given** an exotic that requires a specific
ability (curated `exoticAbilityRequirements`)
**When** it is set on the build **Then** the
system proposes pinning that ability at build
level **And** after confirm, mismatched kits
cannot save" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="12100" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="383" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="377" target="382"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="384" value="Aspects (max 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="12227" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="385" value="DBR-SUB-004 — DBR-SUB-004 Illegal subclass
kits (invalid combinations or over
aspect/fragment slot limits) **cannot be
saved**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="12227" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="386" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="384" target="385"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="387" value="DAC-DST-003 — Subclass slot limits **Given** a
subclass kit over aspect/fragment limits or
otherwise illegal **When** the user saves
**Then** save is rejected **And** the
Aspects/Fragments UI caps picks (max 2
aspects; fragments ≤ aspect capacity) when
capacity is known" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="12293" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="388" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="384" target="387"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="389" value="Fragments (≤ aspect capacity)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="12420" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="390" value="DBR-SUB-004 — DBR-SUB-004 Illegal subclass
kits (invalid combinations or over
aspect/fragment slot limits) **cannot be
saved**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="12420" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="391" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="389" target="390"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="392" value="DAC-DST-003 — Subclass slot limits **Given** a
subclass kit over aspect/fragment limits or
otherwise illegal **When** the user saves
**Then** save is rejected **And** the
Aspects/Fragments UI caps picks (max 2
aspects; fragments ≤ aspect capacity) when
capacity is known" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="12486" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="393" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="389" target="392"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="394" value="Super selection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="12613" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="395" value="DBR-ID-007 — DBR-ID-007 **Super** is normally
**variant-level**. It may be **build-pinned**;
when pinned, it is identity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="12613" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="396" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="394" target="395"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="397" value="DBR-SUB-003 — DBR-SUB-003 **Aspects,
fragments, and ability choices** may differ
per variant, except build-pinned Super /
exotic-required pinned abilities." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="12668" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="398" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="394" target="397"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="399" value="Subclass tree / element (shared)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="12762" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="400" value="DBR-SUB-001 — DBR-SUB-001 **Subclass
element/tree** is shared across all variants
(Solar, Arc, Void, Stasis, Strand, Prismatic)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="12762" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="401" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="399" target="400"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="402" value="DBR-SUB-002 — DBR-SUB-002 **Prismatic** uses
the same rules as other trees — no special
identity model." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="12817" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="403" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="399" target="402"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="404" value="Edit — Weapon sets
[signed-in]
/build
📷 build-edit-weapon-reuse, build-edit-weapon-create" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="12900" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="405" value="DAC-P1-004 — Compose via sets with overrides
**Given** a variant under edit **When** the
user attaches Sets (live by default) and/or
pins slot overrides **Then** the variant
resolves to a coherent loadout without
unresolved slot conflicts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="12900" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="406" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="404" target="405"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="407" value="DBR-CMP-001 — DBR-CMP-001 **Sets are the
normal composition path** (Weapon, Armor, Mod,
Pair, Fashion)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="12988" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="408" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="404" target="407"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="409" value="DBR-CMP-007 — DBR-CMP-007 At most **one exotic
weapon** and **one exotic armor** (including
exotic class item) — **hard on save**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="13043" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="410" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="404" target="409"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="411" value="DBR-ROLL-001 — DBR-ROLL-001 Planning may
reference **catalog** items and **desired
rolls** not yet owned." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="13098" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="412" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="404" target="411"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="413" value="BR-ATT-001 — BR-ATT-001 Users attach one or
more Sets to a Build variant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="13153" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="414" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="404" target="413"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="415" value="Weapon Create + slot fill
[signed-in]
/build
📷 build-edit-weapon-create" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;fontColor=#e8e8e8;strokeColor=#533483;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="13225" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="416" value="DAC-P2-005 — In-flow create still works
**Given** a thin library **When** the user
composes a build **Then** they can create
needed synergies/sets during compose without a
hard library gate --- ## Variants &amp; identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="13225" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="417" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="415" target="416"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="418" value="BR-BLD-008 — BR-BLD-008 Finish primary path is
**slot-first**: one-tap Create (inherited
name, category type, no tags) or preferred
Capture, then first empty required slot fill
loop. Finish does not require
link/name/type/tag chrome; variant Sets tab
retains advanced create/link." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="13302" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="419" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="415" target="418"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="420" value="DBR-ROLL-010 — DBR-ROLL-010 Catalog **browse**
for composition supports multi-dimension
filtering (e.g. element, ammo,
archetype/frame, slot, class, exotic
constraint, free-text, optional synergy
membership) with **include OR within a
facet**, **AND across facets**, and
**exclude** drops; optional **group-by** one
or more dimensions for browse. Catalog is a
composition aid, not a separate product job
(see DBR-PUR-002)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="13401" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="421" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="415" target="420"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="422" value="Slot fill (catalog embed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="13572" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="423" value="DAC-NME-003 — Catalog multi-facet browse
**Given** a user browsing weapons or armor in
Catalog (including set-fill constrained pick)
**When** they combine free-text with
multi-value facets (e.g. element, ammo,
archetype) including include and exclude
**Then** results respect OR-within-facet,
AND-across-facets, and exclude-drop semantics
**And** optional group-by dimensions partition
the result list without changing filter
semantics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="13572" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="424" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="422" target="423"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="425" value="DBR-ROLL-010 — DBR-ROLL-010 Catalog **browse**
for composition supports multi-dimension
filtering (e.g. element, ammo,
archetype/frame, slot, class, exotic
constraint, free-text, optional synergy
membership) with **include OR within a
facet**, **AND across facets**, and
**exclude** drops; optional **group-by** one
or more dimensions for browse. Catalog is a
composition aid, not a separate product job
(see DBR-PUR-002)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="13715" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="426" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="422" target="425"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="427" value="DAC-DST-009 — UI prevention of hard
composition constraints **Given** a user
composing a Set (slot fill) or Build/variant
(equipment, exotics, kit, mods) **When** an
action would violate a Destiny hard rule
(illegal set slot item, **second exotic in a
weapon/armor set**, dual exotic on a variant,
slot conflict, illegal kit, mod energy, exotic
ability mismatch) **Then** the normal UI
filters or blocks the action with
plain-language reasons **And** the API still
rejects the same invalid payload if submitted
--- ## Naming &amp; browsing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="13858" width="300" height="157" as="geometry"/></mxCell>
        <mxCell id="428" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="422" target="427"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="429" value="BR-SLOT-008 — BR-SLOT-008 **Weapon Sets**: at
most **one exotic weapon** across all slots
(kit must stay attachable without
dual-exotic). Replacing the slot that holds
the exotic is allowed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="14023" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="430" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="422" target="429"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="431" value="BR-SLOT-009 — BR-SLOT-009 **Armor Sets**: at
most **one exotic armor** (including exotic
class item) across all slots. Replacing the
exotic piece’s slot is allowed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="696" y="13572" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="422" target="431"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="433" value="Single exotic weapon hard gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d0000;fontColor=#ffcccc;strokeColor=#ff6b6b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="13800" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="434" value="DBR-CMP-007 — DBR-CMP-007 At most **one exotic
weapon** and **one exotic armor** (including
exotic class item) — **hard on save**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="13800" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="435" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="433" target="434"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="436" value="DAC-DST-001 — Exotic limits **Given** a
variant that would equip two exotic weapons or
two exotic armor pieces **When** the user
saves **Then** save is rejected **And** the
normal UI prevents selecting / completing the
second exotic when composition is known" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="13855" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="437" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="433" target="436"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="438" value="Weapon Reuse
[signed-in]
/build
📷 build-edit-weapon-reuse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;fontColor=#e8e8e8;strokeColor=#533483;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="13971" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="439" value="BR-ATT-001 — BR-ATT-001 Users attach one or
more Sets to a Build variant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="13971" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="440" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="438" target="439"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="441" value="DBR-CMP-003 — DBR-CMP-003 Set attachments
default to **live**; user may snapshot for a
frozen equipable variant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="14015" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="442" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="438" target="441"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="443" value="Desired roll / wishlist pin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="14098" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="444" value="DAC-P1-005 — Wishlist vs equip-ready **Given**
a variant with a desired roll the user does
not own **When** they save **Then** the
variant saves with desired roll data (item +
plugs) marked unowned **And** in-game equip
and DIM export for that variant are blocked
until every applied slot has a pinned owned
instance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="14098" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="445" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="443" target="444"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="446" value="DBR-ROLL-001 — DBR-ROLL-001 Planning may
reference **catalog** items and **desired
rolls** not yet owned." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="14208" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="447" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="443" target="446"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="448" value="DBR-ROLL-002 — DBR-ROLL-002 A wishlist/unowned
slot stores **desired roll data**: item hash +
perk/plug selections (including origin trait,
masterwork, crafted/enhanced plugs as
applicable) — not an instance id." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="14263" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="449" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="443" target="448"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="450" value="DBR-ROLL-005 — DBR-ROLL-005 Variants may be
**saved** without instance pins (wishlist OK).
Equip/export is blocked until pins exist for
applied slots." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="14340" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="451" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="443" target="450"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="452" value="BR-ROLL-001 — BR-ROLL-001 Weapon SetItems
store **full roll data** (perks, barrels,
traits, masterwork, etc.)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="14406" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="453" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="443" target="452"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="454" value="Finish tab — readiness + walkthrough
[signed-in]
/build
📷 build-edit-finish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="14489" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="455" value="DAC-P1-003 — Default variant full combat
loadout **Given** the default variant **When**
the user marks it complete / saves as the
build’s default **Then** it includes class,
subclass tree, a legal subclass kit, all
weapon slots, all armor slots, and mods (via
Mod Sets / overrides) **And** illegal kits,
over-capacity mods, or &gt;1 exotic weapon/armor
cannot save" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="14489" width="300" height="113" as="geometry"/></mxCell>
        <mxCell id="456" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="454" target="455"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="457" value="DAC-P1-005 — Wishlist vs equip-ready **Given**
a variant with a desired roll the user does
not own **When** they save **Then** the
variant saves with desired roll data (item +
plugs) marked unowned **And** in-game equip
and DIM export for that variant are blocked
until every applied slot has a pinned owned
instance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="14610" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="458" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="454" target="457"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="459" value="DAC-P1-007 — Equip in-game (Bungie API)
**Given** an equip-ready default variant
(owned instance pins on all applied slots)
**When** the user equips **Then** inventory
refreshes (respecting ~1/min rate limit), the
user picks a class-matching character, items
transfer from vault/other characters as
needed, and the loadout + artifact config (+
fashion if specified) are applied via Bungie
API **And** failures are reported as
best-effort partial apply; retry is the
recovery path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="14720" width="300" height="146" as="geometry"/></mxCell>
        <mxCell id="460" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="454" target="459"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="461" value="DAC-P1-008 — DIM export **Given** the same
equip-ready variant **When** the user exports
to DIM **Then** a full variant loadout is
produced (subclass kit, gear, mods, fashion,
artifact) **And** wishlist-only / unpinned
variants cannot export" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="14874" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="462" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="454" target="461"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="463" value="BR-BLD-007 — BR-BLD-007 Production Builds
provides a **guided finish walkthrough**
(Armor → Weapons → Mods): create empty Set +
live attach (replace-by-type), link existing,
capture-from-build when resolved gear exists,
fill slots from Builds; Skip for now does not
satisfy. **v1 shipped in 028.**" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="14962" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="464" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="454" target="463"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="465" value="BR-BLD-008 — BR-BLD-008 Finish primary path is
**slot-first**: one-tap Create (inherited
name, category type, no tags) or preferred
Capture, then first empty required slot fill
loop. Finish does not require
link/name/type/tag chrome; variant Sets tab
retains advanced create/link." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="14489" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="466" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="454" target="465"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="467" value="BR-BLD-009 — BR-BLD-009 Finish **Armor** after
a live covering Set: goals (synergy-linked set
bonuses first, seeded stats) → Find kits
(optimize with build class) → top-3 compare →
apply-combination in place; manual fill
fallback; weapons/mods remain slot-first." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="14588" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="468" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="454" target="467"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="469" value="DBR-CMPL-001 — DBR-CMPL-001 **Default
variant** must be a **full combat loadout**
(class, subclass kit, all weapon slots, all
armor slots, mods as part of the build)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="14676" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="470" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="454" target="469"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="471" value="DBR-EQP-003 — DBR-EQP-003 Both equip and DIM
export require **owned, instance-pinned**
slots for everything being applied;
wishlist-only variants are blocked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="14742" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="472" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="454" target="471"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="473" value="Armor optimize workspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;fontColor=#e8e8e8;strokeColor=#533483;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="14877" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="474" value="BR-BLD-009 — BR-BLD-009 Finish **Armor** after
a live covering Set: goals (synergy-linked set
bonuses first, seeded stats) → Find kits
(optimize with build class) → top-3 compare →
apply-combination in place; manual fill
fallback; weapons/mods remain slot-first." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="14877" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="475" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="473" target="474"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="476" value="BR-OPT-001 — BR-OPT-001 Create-from-build and
first-time materialize with **attach-now** use
**replace-by-type**: detach existing live
attachment(s) of the **same set type** on the
variant, then attach the new Set(s). Other
types unchanged; detached Sets remain in the
library. Names auto-suffix on collision." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="14965" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="477" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="473" target="476"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="478" value="BR-OPT-002 — BR-OPT-002 Armor Sets MAY store
**`optimizerConstraints`** (JSON): exotic
lock, set-bonus goals, ordered stat
priorities/thresholds, mod-aware flag,
**`preferReuse`** (default false).
Create-from-build **seeds** exotic + soft-stat
fields (empty set-bonus goals). First
materialize **persists** search constraints;
refresh **updates items in place** without
changing constraints unless the user
edits/saves or **clears** them (clear opts out
of improvement checks)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="15064" width="300" height="146" as="geometry"/></mxCell>
        <mxCell id="479" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="473" target="478"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="480" value="BR-OPT-003 — BR-OPT-003 Optimize results
**annotate** pieces with other Armor Sets that
already use the instance (active items only;
self excluded). Optional **prefer-reuse** is a
**soft tie-break** after lexicographic stats
(+ prioritized-stat sum); never ranks a
worse-stat kit above a better one." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="15218" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="481" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="473" target="480"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="482" value="BR-OPT-004 — BR-OPT-004 After inventory sync,
soft-**suggest** better complete kits for
constrained Armor Sets **attached to ≥1
Build**; opening an unattached constrained Set
also checks. **Suggest-then-confirm** — never
silent auto-apply. Manual refresh remains
available." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="15317" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="483" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="473" target="482"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="484" value="031:SC-001 — 031-finish-armor-optimize-ui
SC-001 Scripted Finish armor create → goals →
find → apply fills 5 slots without Sets
library." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="666" y="14877" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="485" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="473" target="484"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="486" value="Apply combination in place" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="15145" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="487" value="Top-3 compare" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="15209" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="488" value="Find kits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="15273" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="489" value="Goals (set bonuses + seeded stats)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="15337" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="490" value="Character picker (equip)
📷 build-edit-finish" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="15401" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="491" value="DBR-BLD-004 — DBR-BLD-004 Builds are
**class-bound** (Titan / Hunter / Warlock).
Character is chosen at equip time." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="15401" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="492" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="490" target="491"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="493" value="DBR-EQP-005 — DBR-EQP-005 At equip, user
**always chooses** the target character among
class-matching characters." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="15456" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="494" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="490" target="493"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="495" value="DAC-P1-007 — Equip in-game (Bungie API)
**Given** an equip-ready default variant
(owned instance pins on all applied slots)
**When** the user equips **Then** inventory
refreshes (respecting ~1/min rate limit), the
user picks a class-matching character, items
transfer from vault/other characters as
needed, and the loadout + artifact config (+
fashion if specified) are applied via Bungie
API **And** failures are reported as
best-effort partial apply; retry is the
recovery path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="15511" width="300" height="146" as="geometry"/></mxCell>
        <mxCell id="496" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="490" target="495"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="497" value="DIM export / share
📷 build-edit-finish" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="15693" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="498" value="DAC-P1-008 — DIM export **Given** the same
equip-ready variant **When** the user exports
to DIM **Then** a full variant loadout is
produced (subclass kit, gear, mods, fashion,
artifact) **And** wishlist-only / unpinned
variants cannot export" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="15693" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="499" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="497" target="498"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="500" value="DBR-EQP-002 — DBR-EQP-002 **DIM export** of a
full variant loadout is also a core
capability." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="15781" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="501" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="497" target="500"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="502" value="DBR-EQP-003 — DBR-EQP-003 Both equip and DIM
export require **owned, instance-pinned**
slots for everything being applied;
wishlist-only variants are blocked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="15836" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="503" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="497" target="502"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="504" value="DBR-EQP-004 — DBR-EQP-004 DIM export includes:
subclass kit, weapons/armor, mods, fashion,
artifact config." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="15902" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="505" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="497" target="504"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="506" value="Equip in-game
📷 build-edit-finish" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="15985" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="507" value="DAC-P1-007 — Equip in-game (Bungie API)
**Given** an equip-ready default variant
(owned instance pins on all applied slots)
**When** the user equips **Then** inventory
refreshes (respecting ~1/min rate limit), the
user picks a class-matching character, items
transfer from vault/other characters as
needed, and the loadout + artifact config (+
fashion if specified) are applied via Bungie
API **And** failures are reported as
best-effort partial apply; retry is the
recovery path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="15985" width="300" height="146" as="geometry"/></mxCell>
        <mxCell id="508" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="506" target="507"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="509" value="DBR-EQP-001 — DBR-EQP-001 In-game equip via
**direct Bungie API** is a core capability." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16139" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="510" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="506" target="509"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="511" value="DBR-EQP-003 — DBR-EQP-003 Both equip and DIM
export require **owned, instance-pinned**
slots for everything being applied;
wishlist-only variants are blocked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16183" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="512" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="506" target="511"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="513" value="DBR-EQP-005 — DBR-EQP-005 At equip, user
**always chooses** the target character among
class-matching characters." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16249" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="514" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="506" target="513"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="515" value="DBR-EQP-006 — DBR-EQP-006 Equip **transfers**
required items from vault/other characters,
then equips." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16304" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="516" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="506" target="515"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="517" value="DBR-EQP-007 — DBR-EQP-007 Inventory is
**refreshed on equip**, subject to Bungie rate
limits (~**once per minute**); reuse a
fresh-enough sync within that window." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16359" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="518" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="506" target="517"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="519" value="DBR-EQP-008 — DBR-EQP-008 Equip is
**best-effort partial**: apply what succeeded,
report failures, leave character as-is;
**retry** until it works. No hard rollback
requirement." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16425" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="520" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="506" target="519"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="521" value="DAC-VAR-001 — Non-default gaps **Given** a
non-default variant with some empty combat
slots **When** the user confirms
equip-with-gaps **Then** specified slots apply
and empty slots leave character gear unchanged" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="666" y="15985" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="522" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="506" target="521"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="523" value="Equip/export blocked until pins
📷 build-edit-finish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d0000;fontColor=#ffcccc;strokeColor=#ff6b6b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="16333" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="524" value="DAC-P1-005 — Wishlist vs equip-ready **Given**
a variant with a desired roll the user does
not own **When** they save **Then** the
variant saves with desired roll data (item +
plugs) marked unowned **And** in-game equip
and DIM export for that variant are blocked
until every applied slot has a pinned owned
instance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16333" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="525" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="523" target="524"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="526" value="DBR-EQP-003 — DBR-EQP-003 Both equip and DIM
export require **owned, instance-pinned**
slots for everything being applied;
wishlist-only variants are blocked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16443" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="527" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="523" target="526"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="528" value="DBR-ROLL-004 — DBR-ROLL-004 **Equip** requires
a **pinned owned instance** for **every
equipment slot being applied**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16509" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="529" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="523" target="528"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="530" value="DBR-ROLL-005 — DBR-ROLL-005 Variants may be
**saved** without instance pins (wishlist OK).
Equip/export is blocked until pins exist for
applied slots." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16564" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="531" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="523" target="530"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="532" value="Gap list / missing reasons
📷 build-edit-finish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="16658" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="533" value="DBR-CMPL-001 — DBR-CMPL-001 **Default
variant** must be a **full combat loadout**
(class, subclass kit, all weapon slots, all
armor slots, mods as part of the build)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16658" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="534" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="532" target="533"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="535" value="DBR-CMPL-002 — DBR-CMPL-002 **Non-default
variants** may leave some combat slots
**empty**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16724" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="536" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="532" target="535"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="537" value="BR-SAVE-001 — BR-SAVE-001 **Superseded by**
[DBR-CMPL-001](./domain-business-rules.md):
default variant must be a **full combat
loadout**, not merely ≥1 slot." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16779" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="538" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="532" target="537"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="539" value="BR-SAVE-002 — BR-SAVE-002 **Superseded in part
by**
[DBR-CMPL-002](./domain-business-rules.md):
non-default variants may have empty slots;
default must be complete. Wishlist/unowned
desired rolls may save; equip gated separately
([DBR-ROLL-005](./domain-business-rules.md))." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="16845" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="540" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="532" target="539"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="541" value="Capture sets from build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="16972" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="542" value="One-tap Create set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="17036" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="543" value="First empty slot fill loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="17100" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="544" value="Build library
[signed-in]
/build
📷 build-library" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="17164" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="545" value="DBR-BLD-001 — DBR-BLD-001 A **Build** is both
a **fully equippable loadout** and a **stable
identity** with **variants**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="17164" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="546" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="544" target="545"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="547" value="DBR-BLD-005 — DBR-BLD-005 Builds are
**private** per user. Shareable read-only
links are planned, not required for the first
equippable composer slice." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="17219" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="548" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="544" target="547"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="549" value="BR-BLD-001 — BR-BLD-001 Build contains one
default variant and optional additional
variants." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="17285" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="550" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="544" target="549"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="551" value="BR-TAG-006 — BR-TAG-006 Builds use the **same
concept tag vocabulary** as Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="17340" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="552" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="544" target="551"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="553" value="BR-TAG-008 — BR-TAG-008 Tag filter is
available in **SetAttachPicker**, **Sets
list**, and **Builds list**; empty state when
no matches." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="17384" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="554" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="544" target="553"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="555" value="BR-VAR-004 — BR-VAR-004 Filter builds by
exotic armor, exotic weapon, and concept tags." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="17450" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="556" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="544" target="555"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="557" value="DAC-NME-002 — Tag filter without identity
**Given** builds tagged PVE or Dungeon without
matching synergies **When** the user filters
by those tags **Then** matching builds appear
**And** changing tags does not trigger
identity confirm/fork" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="17494" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="558" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="544" target="557"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="559" value="001:SC-002 — 001-build-sets-synergies SC-002
Sets or synergies can be located using search
or concept tag filters in under 5 seconds." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="17582" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="560" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="544" target="559"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="561" value="Build list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="17665" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="562" value="Filter by exotic armor / weapon" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="17729" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="563" value="BR-VAR-004 — BR-VAR-004 Filter builds by
exotic armor, exotic weapon, and concept tags." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="17729" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="564" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="562" target="563"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="565" value="Concept tag filter (AND)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="17801" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="566" value="BR-TAG-007 — BR-TAG-007 Multi-tag filter uses
**AND semantics**: `Solar` + `Melee` returns
only entities with **both** tags." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="17801" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="567" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="565" target="566"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="568" value="BR-TAG-008 — BR-TAG-008 Tag filter is
available in **SetAttachPicker**, **Sets
list**, and **Builds list**; empty state when
no matches." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="17856" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="569" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="565" target="568"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="570" value="BR-TAG-009 — BR-TAG-009 UI notation like
`Solar · Melee` is a **filter shorthand** for
two tags — not a single compound tag." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="17922" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="571" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="565" target="570"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="572" value="DAC-NME-002 — Tag filter without identity
**Given** builds tagged PVE or Dungeon without
matching synergies **When** the user filters
by those tags **Then** matching builds appear
**And** changing tags does not trigger
identity confirm/fork" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="17977" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="573" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="565" target="572"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="574" value="DBR-ID-002 — DBR-ID-002 **Concept tags are not
identity**. Tags are optional filter metadata
(e.g. PVE, Dungeon) when no synergy covers
that context. Changing tags does not fork
identity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="18065" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="575" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="565" target="574"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="576" value="Build row (name, class, identity hints)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="18170" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="577" value="DAC-NME-001 — Default and unique names
**Given** a new build **When** saved without a
custom name **Then** a default name is derived
from Class, Element, Super, Exotic Armor,
Exotic Weapon, Synergies (omitting missing
segments) **And** manual renames are unique
per class" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="18170" width="300" height="91" as="geometry"/></mxCell>
        <mxCell id="578" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="576" target="577"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="579" value="DBR-NAME-001 — DBR-NAME-001 Default Build name
is derived from: **Class, Element, Super,
Exotic Armor, Exotic Weapon, Synergies**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="18269" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="580" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="576" target="579"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="581" value="Search builds by name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="18352" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="582" value="New Build action" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="18416" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="583" value="Selected build summary
[signed-in]
/build
📷 build-library-selected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;fontColor=#e8e8e8;strokeColor=#533483;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="18480" width="220" height="68" as="geometry"/></mxCell>
        <mxCell id="584" value="DBR-BLD-001 — DBR-BLD-001 A **Build** is both
a **fully equippable loadout** and a **stable
identity** with **variants**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="18480" width="300" height="47" as="geometry"/></mxCell>
