        <mxCell id="175" value="BR-ATT-002 — BR-ATT-002 Attachment mode:
**live** (default) or **snapshot**, per
variant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="5703" width="300" height="47" as="geometry"/></mxCell>
