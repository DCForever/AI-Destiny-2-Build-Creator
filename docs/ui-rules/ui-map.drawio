        <mxCell id="215" value="DBR-FASH-004 — DBR-FASH-004 Omitted fashion
slots **leave character cosmetics as-is** on
equip." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="636" y="6343" width="300" height="47" as="geometry"/></mxCell>
