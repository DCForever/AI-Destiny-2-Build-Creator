  <diagram id="cross-cutting" name="Cross-cutting">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2702" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Cross-cutting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#e2b714;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="3" value="Structure SSoT for surfaces, flows, and rule attachments across platforms. Rule
wording lives in specs/domain-*.md and business-rules.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="380" y="24" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="4" value="ConceptTagPicker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="5" value="BR-TAG-001 — BR-TAG-001 Sets and Builds carry
**zero or more concept tags** from a
system-defined vocabulary — not user-typed
strings." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="7" value="BR-TAG-003 — BR-TAG-003 Invalid or unknown tag
values are rejected at API boundary with
`INVALID_TAG`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="166" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="9" value="BR-TAG-005 — BR-TAG-005 Tag assignment is
**multi-select** on create/edit via
`ConceptTagPicker`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="221" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="11" value="BR-TAG-006 — BR-TAG-006 Builds use the **same
concept tag vocabulary** as Sets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="276" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="4" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="13" value="ManifestSearchPicker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="348" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="14" value="DBR-ROLL-010 — DBR-ROLL-010 Catalog **browse**
for composition supports multi-dimension
filtering (e.g. element, ammo,
archetype/frame, slot, class, exotic
constraint, free-text, optional synergy
membership) with **include OR within a
facet**, **AND across facets**, and
**exclude** drops; optional **group-by** one
or more dimensions for browse. Catalog is a
composition aid, not a separate product job
(see DBR-PUR-002)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="348" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="16" value="BR-CAT-005 — BR-CAT-005 Filter/search
completes in &lt;5 seconds." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="491" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="13" target="16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="18" value="025:SC-001 — 025-lookup-only-fields SC-001 On
production create, 100% of subclass, exotic
armor, and pinned super values submitted come
from lookup selections (or remain empty for
optional fields) — zero free-typed identity
strings." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="535" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="13" target="18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="20" value="Search query" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="651" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="21" value="Result list / pick" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b262c;fontColor=#bbe1fa;strokeColor=#3282b8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="715" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="22" value="Performance expectations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="779" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="23" value="BR-PERF-001 — BR-PERF-001 Set attach and
slot-conflict checks: &lt;100ms." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="779" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="22" target="23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="25" value="BR-PERF-002 — BR-PERF-002 Support ≥30 sets and
≥20 synergies without UI lag." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="823" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="22" target="25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="27" value="BR-PERF-003 — BR-PERF-003 Tag filter on 30+
sets: &lt;5 seconds." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="867" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="22" target="27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="29" value="001:SC-007 — 001-build-sets-synergies SC-007
The system supports users maintaining at least
30 sets and 20 synergies without noticeable
slowdown in listing or filtering." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="911" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="22" target="29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="31" value="SetAttachPicker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1005" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="32" value="BR-ATT-001 — BR-ATT-001 Users attach one or
more Sets to a Build variant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1005" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="31" target="32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="34" value="BR-TAG-008 — BR-TAG-008 Tag filter is
available in **SetAttachPicker**, **Sets
list**, and **Builds list**; empty state when
no matches." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1049" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="31" target="34"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="36" value="BR-SUG-001 — BR-SUG-001 Set suggestions:
automatic (contextual) and explicit (user
action/goal)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1115" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="31" target="36"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="38" value="BR-TAG-010 — BR-TAG-010 Suggestions score by
tag overlap; explicit attach-flow filter is
separate from automatic suggestions." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1170" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="31" target="38"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="40" value="SynergyTypeMultiSelect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222831;fontColor=#eeeeee;strokeColor=#00adb5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1253" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="41" value="DBR-SYN-002 — DBR-SYN-002 Builds are created
**intent-first**: user designates **Synergy
Types** (`type` + optional `subType` only —
e.g. Verb: Devour, Melee, Primary Weapon). The
system **bridges** those Types to matching
curated Synergies (Type + Object) for coverage
and suggestions. A library Synergy need not
exist for a Type designation to be valid." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1253" width="300" height="102" as="geometry"/></mxCell>
        <mxCell id="42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="40" target="41"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="43" value="DBR-SYN-003 — DBR-SYN-003 Every Build must
designate **≥1 Synergy Type** to save
(`NO_SYNERGY` otherwise)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1363" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="40" target="43"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="45" value="DBR-SYN-004 — DBR-SYN-004 Multiple designated
Synergy Types contribute **equally** to
suggestions and coverage. Soft UI nudge toward
roughly **2–5**; no hard maximum. Matched
library Synergies for the same Type are
**unioned** (equal weight)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1418" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="40" target="45"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="47" value="DAC-P1-001 — Intent to designated Synergy
Types **Given** a signed-in user starting a
new Build **When** they state intent via
controlled vocabulary (Synergy Types: type +
optional subType) **Then** the user designates
≥1 Synergy Type (library Synergy records are
not required to save) **And** the system
bridges designations to matching curated
Synergies (Type + Object) for
coverage/suggestions when present **And** when
a designated verb implies an element, that
element is included in effective bridging
without requiring a separate element
designation **And** save is rejected with
`NO_SYNERGY` if zero Synergy Types are
designated" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1506" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="40" target="47"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="49" value="UI prevention of hard constraints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d0000;fontColor=#ffcccc;strokeColor=#ff6b6b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1732" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="50" value="DAC-DST-009 — UI prevention of hard
composition constraints **Given** a user
composing a Set (slot fill) or Build/variant
(equipment, exotics, kit, mods) **When** an
action would violate a Destiny hard rule
(illegal set slot item, **second exotic in a
weapon/armor set**, dual exotic on a variant,
slot conflict, illegal kit, mod energy, exotic
ability mismatch) **Then** the normal UI
filters or blocks the action with
plain-language reasons **And** the API still
rejects the same invalid payload if submitted
--- ## Naming &amp; browsing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1732" width="300" height="157" as="geometry"/></mxCell>
        <mxCell id="51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="49" target="50"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="52" value="BR-UI-001 — BR-UI-001 **UI prevents Destiny
hard constraints** for Sets and Builds:
illegal set slot items are not completable via
normal fill; **set-wide exotic exclusivity**
(≤1 exotic weapon per weapon set, ≤1 exotic
armor per armor set); dual exotic on builds;
occupied set slots require replace confirm;
**aspect/fragment capacity**, **armor mod
energy**, and **exotic ability requirements**
when known. Soft guidance remains
non-blocking. **API remains authoritative**." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1897" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="49" target="52"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="54" value="DBR-GUID-003 — DBR-GUID-003 Hard blocks are
reserved for true Destiny/system constraints
(exotics limits, energy, illegal kits,
ownership/pins for equip, required links on
default, etc.). Where pickers exist, **hard
constraints must not be UI-selectable**
(filter/disable illegal options); primary
Save/Create/Fill actions stay **disabled**
when hard blocks remain. Soft guidance never
disables Save on non-default variants. API
remains authoritative." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="2040" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="49" target="54"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="56" value="API / form validation codes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d0000;fontColor=#ffcccc;strokeColor=#ff6b6b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="2211" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="57" value="BR-VAL-001 — BR-VAL-001 API inputs validated
with zod at route boundary." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="2211" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="56" target="57"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="59" value="BR-VAL-002 — BR-VAL-002 Manifest item hashes
validated before persistence." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="2255" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="56" target="59"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="61" value="BR-VAL-003 — BR-VAL-003 Concept tag ids
validated against `conceptTags.ts` enum." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="2299" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="56" target="61"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="63" value="BR-TAG-003 — BR-TAG-003 Invalid or unknown tag
values are rejected at API boundary with
`INVALID_TAG`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="2343" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="56" target="63"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="65" value="BR-SAVE-003 — BR-SAVE-003 Build must designate
≥1 synergy; zero → `NO_SYNERGY`. Affirmed by
[DBR-SYN-003](./domain-business-rules.md)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="2398" width="300" height="47" as="geometry"/></mxCell>
        <mxCell id="66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="56" target="65"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="67" value="BR-SAVE-004 — BR-SAVE-004 Empty variant error:
`VARIANT_EMPTY` — applies when a variant that
must be complete (default) has no equipment;
non-default gaps are allowed per
[DBR-CMPL-002](./domain-business-rules.md)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="2453" width="300" height="69" as="geometry"/></mxCell>
        <mxCell id="68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="56" target="67"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="69" value="BR-CONF-003 — BR-CONF-003 Error code:
`SLOT_CONFLICT`." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="2530" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#bbb;dashed=1;endArrow=none;opacity=60;" edge="1" parent="1" source="56" target="69"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="71" value="DAC (acceptance)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="2622" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="72" value="DBR (domain BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="190" y="2622" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="73" value="BR (feature BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="340" y="2622" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="74" value="Slice AC/SC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="490" y="2622" width="140" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="journey" name="Journey">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Journey" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#e2b714;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="3" value="Structure SSoT for surfaces, flows, and rule attachments across platforms. Rule
wording lives in specs/domain-*.md and business-rules.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="380" y="24" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="4" value="Compose default variant (sets + kit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="5" value="Equip / DIM when equip-ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="6" value="Designate Synergy Types" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="228" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="7" value="DAC (acceptance)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="8" value="DBR (domain BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="190" y="312" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="9" value="BR (feature BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="340" y="312" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="10" value="Slice AC/SC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="490" y="312" width="140" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="shared" name="Shared">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Shared" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#e2b714;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="3" value="Structure SSoT for surfaces, flows, and rule attachments across platforms. Rule
wording lives in specs/domain-*.md and business-rules.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="380" y="24" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="4" value="Confirm / edit before persist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="5" value="Review proposals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="6" value="Start pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;fontColor=#e8e8e8;strokeColor=#0f9b8e;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="228" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="7" value="DAC (acceptance)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e7;fontColor=#333;strokeColor=#e2b714;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="8" value="DBR (domain BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontColor=#222;strokeColor=#43a047;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="190" y="312" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="9" value="BR (feature BR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;fontColor=#222;strokeColor=#1e88e5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="340" y="312" width="140" height="32" as="geometry"/></mxCell>
        <mxCell id="10" value="Slice AC/SC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;fontColor=#222;strokeColor=#8e24aa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="490" y="312" width="140" height="32" as="geometry"/></mxCell>
