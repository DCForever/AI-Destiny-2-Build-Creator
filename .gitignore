npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# env files at repo root
.env*
!.env.local.example

# manifest raw tables + derived entity stores (legacy root)
/.cache/

# local https certs
/certificates/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

